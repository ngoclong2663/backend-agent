<mxfile host="drawio"><diagram id="app-kit-domains" name="App kit with domain plugins"><mxGraphModel dx="1250" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1680" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="How the app kit builds the UI with domain plugins (Epic 33, proposed): a social video example" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="subt" value="Top: the plugin tree. Bottom: the same app built today and with domain plugins, step by step. Today’s full flow is app-kit-assembly.png." style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1200" height="22" as="geometry"/></mxCell><mxCell id="gt" value="The plugin tree" style="rounded=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=13;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1210" height="330" as="geometry"/></mxCell><mxCell id="root" value="App Kit" style="rounded=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;align=center;spacingLeft=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="120" height="50" as="geometry"/></mxCell><mxCell id="d_learn" value="Learning" style="rounded=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="140" height="40" as="geometry"/></mxCell><mxCell id="er_d_learn" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="root" target="d_learn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_soc" value="Socials" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="230" y="165" width="140" height="40" as="geometry"/></mxCell><mxCell id="er_d_soc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="root" target="d_soc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_news" value="News" style="rounded=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="230" y="220" width="140" height="40" as="geometry"/></mxCell><mxCell id="er_d_news" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="root" target="d_news"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_drv" value="Drivers" style="rounded=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="230" y="275" width="140" height="40" as="geometry"/></mxCell><mxCell id="er_d_drv" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="root" target="d_drv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d_iot" value="Edge AI / IoT" style="rounded=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="230" y="330" width="140" height="40" as="geometry"/></mxCell><mxCell id="er_d_iot" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="root" target="d_iot"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ty_h" value="&lt;b&gt;Types&lt;/b&gt; (page set of each area)" style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="250" height="24" as="geometry"/></mxCell><mxCell id="ty1" value="&lt;b&gt;Short-video feed&lt;/b&gt;&lt;br&gt;one video per screen, comments in a sheet, profile grid" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="250" height="60" as="geometry"/></mxCell><mxCell id="ty2" value="Photo &amp;amp; post feed&lt;br&gt;post cards, comments on the post page" style="rounded=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="430" y="210" width="250" height="50" as="geometry"/></mxCell><mxCell id="fe_h" value="&lt;b&gt;Features&lt;/b&gt; (full stack: data, rules, API, mocks, UI, checks)" style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="500" height="24" as="geometry"/></mxCell><mxCell id="f_com" value="&lt;b&gt;comments&lt;/b&gt;&lt;br&gt;replies · thread · inline&lt;br&gt;&lt;i style='color:#666'&gt;used by socials, news, learning&lt;/i&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="158" height="76" as="geometry"/></mxCell><mxCell id="f_rea" value="&lt;b&gt;reactions&lt;/b&gt;&lt;br&gt;like toggle · liked state · count&lt;br&gt;&lt;i style='color:#666'&gt;socials, news&lt;/i&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="888" y="140" width="158" height="76" as="geometry"/></mxCell><mxCell id="f_fol" value="&lt;b&gt;follow&lt;/b&gt;&lt;br&gt;toggle · follower counts&lt;br&gt;&lt;i style='color:#666'&gt;socials, news topics&lt;/i&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1056" y="140" width="158" height="76" as="geometry"/></mxCell><mxCell id="f_not" value="&lt;b&gt;notifications&lt;/b&gt;&lt;br&gt;bell · unread count&lt;br&gt;&lt;i style='color:#666'&gt;socials, drivers, IoT&lt;/i&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="720" y="230" width="158" height="76" as="geometry"/></mxCell><mxCell id="f_rep" value="&lt;b&gt;reports&lt;/b&gt;&lt;br&gt;moderation queue&lt;br&gt;&lt;i style='color:#666'&gt;socials&lt;/i&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="888" y="230" width="158" height="76" as="geometry"/></mxCell><mxCell id="e_t1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_soc" target="ty1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_t2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d_soc" target="ty2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_f" value="requires" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ty1" target="f_com"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note" value="Grey: other domains and types follow the same shape (Stories 33.8–33.12). A feature is built once and shared: comments serve socials, news and learning." style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="780" height="40" as="geometry"/></mxCell><mxCell id="gc" value="What changes: the same social video app, built today and with domain plugins" style="rounded=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=13;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="1210" height="630" as="geometry"/></mxCell><mxCell id="h0" value="Step" style="rounded=0;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="200" height="36" as="geometry"/></mxCell><mxCell id="h1" value="Today: generic kit (code guesses behaviour)" style="rounded=0;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="480" width="480" height="36" as="geometry"/></mxCell><mxCell id="h2" value="With domain plugins (behaviour comes from plugins)" style="rounded=0;fillColor=#d79b00;strokeColor=#d79b00;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="480" width="490" height="36" as="geometry"/></mxCell><mxCell id="r0" value="1. What the model drafts" style="rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="516" width="200" height="64" as="geometry"/></mxCell><mxCell id="t0" value="every entity itself: Video, &lt;b&gt;Comment&lt;/b&gt;, &lt;b&gt;Like&lt;/b&gt;, with the fields it imagines" style="rounded=0;fillColor=#f5f5f5;strokeColor=#bbbbbb;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="516" width="480" height="64" as="geometry"/></mxCell><mxCell id="n0" value="only the core: domain &lt;i&gt;socials&lt;/i&gt;, type &lt;i&gt;short-video feed&lt;/i&gt;, features; roles &lt;i&gt;post&lt;/i&gt; = Video. &lt;b&gt;No Comment or Like&lt;/b&gt;: the features own them" style="rounded=0;fillColor=#fff5e6;strokeColor=#e0b070;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="516" width="490" height="64" as="geometry"/></mxCell><mxCell id="r1" value="2. Who decides behaviour" style="rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="200" height="64" as="geometry"/></mxCell><mxCell id="t1" value='&lt;font color="#b85450"&gt;&lt;b&gt;✗&lt;/b&gt;&lt;/font&gt; code guesses from the data’s shape: “a child with nothing to fill in is a button”, “a child with text is a dialog form”' style="rounded=0;fillColor=#f5f5f5;strokeColor=#bbbbbb;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="580" width="480" height="64" as="geometry"/></mxCell><mxCell id="n1" value='&lt;font color="#2d7d46"&gt;&lt;b&gt;✓&lt;/b&gt;&lt;/font&gt; the feature plugin states it: comments are threads with replies; a reaction is a toggle with a state' style="rounded=0;fillColor=#fff5e6;strokeColor=#e0b070;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="580" width="490" height="64" as="geometry"/></mxCell><mxCell id="r2" value="3. The data" style="rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="644" width="200" height="64" as="geometry"/></mxCell><mxCell id="t2" value='&lt;font color="#b85450"&gt;&lt;b&gt;✗&lt;/b&gt;&lt;/font&gt; Comment(videoId, text): no &lt;i&gt;parentId&lt;/i&gt;, so no replies&lt;br&gt;&lt;font color="#b85450"&gt;&lt;b&gt;✗&lt;/b&gt;&lt;/font&gt; Like is a plain row: no &lt;i&gt;likedByMe&lt;/i&gt;, a second like fails' style="rounded=0;fillColor=#f5f5f5;strokeColor=#bbbbbb;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="644" width="480" height="64" as="geometry"/></mxCell><mxCell id="n2" value='&lt;font color="#2d7d46"&gt;&lt;b&gt;✓&lt;/b&gt;&lt;/font&gt; VideoComment with &lt;i&gt;parentId&lt;/i&gt;; VideoReaction, one per person&lt;br&gt;&lt;font color="#2d7d46"&gt;&lt;b&gt;✓&lt;/b&gt;&lt;/font&gt; Video gets &lt;i&gt;likedByMe&lt;/i&gt;, &lt;i&gt;likeCount&lt;/i&gt;, &lt;i&gt;commentCount&lt;/i&gt;' style="rounded=0;fillColor=#fff5e6;strokeColor=#e0b070;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="644" width="490" height="64" as="geometry"/></mxCell><mxCell id="r3" value="4. Which pages exist" style="rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="708" width="200" height="64" as="geometry"/></mxCell><mxCell id="t3" value="pages per entity (list, detail, form), trimmed by the &lt;i&gt;feed&lt;/i&gt; pattern" style="rounded=0;fillColor=#f5f5f5;strokeColor=#bbbbbb;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="708" width="480" height="64" as="geometry"/></mxCell><mxCell id="n3" value="the type’s page set, from research: Feed (full screen), Discover, Create, Inbox, Profile" style="rounded=0;fillColor=#fff5e6;strokeColor=#e0b070;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="708" width="490" height="64" as="geometry"/></mxCell><mxCell id="r4" value="5. Parts of the video page" style="rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="772" width="200" height="64" as="geometry"/></mxCell><mxCell id="t4" value="AppDetail + RecordActions: a plain &lt;b&gt;Like&lt;/b&gt; button and an &lt;b&gt;Add comment&lt;/b&gt; form dialog; comments as a flat list of cards" style="rounded=0;fillColor=#f5f5f5;strokeColor=#bbbbbb;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="772" width="480" height="64" as="geometry"/></mxCell><mxCell id="n4" value="AppMediaFeed + &lt;b&gt;ReactionButton&lt;/b&gt; + &lt;b&gt;CommentThread&lt;/b&gt; (sheet, Reply) + &lt;b&gt;FollowButton&lt;/b&gt;" style="rounded=0;fillColor=#fff5e6;strokeColor=#e0b070;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="772" width="490" height="64" as="geometry"/></mxCell><mxCell id="r5" value="6. What the member gets" style="rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="836" width="200" height="64" as="geometry"/></mxCell><mxCell id="t5" value='&lt;font color="#b85450"&gt;&lt;b&gt;✗&lt;/b&gt;&lt;/font&gt; the like shows no state; pressing again shows an error&lt;br&gt;&lt;font color="#b85450"&gt;&lt;b&gt;✗&lt;/b&gt;&lt;/font&gt; comments can’t be answered' style="rounded=0;fillColor=#f5f5f5;strokeColor=#bbbbbb;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="836" width="480" height="64" as="geometry"/></mxCell><mxCell id="n5" value='&lt;font color="#2d7d46"&gt;&lt;b&gt;✓&lt;/b&gt;&lt;/font&gt; the like fills in and the count moves; a second tap removes it&lt;br&gt;&lt;font color="#2d7d46"&gt;&lt;b&gt;✓&lt;/b&gt;&lt;/font&gt; Reply under each comment, “View 2 more replies”' style="rounded=0;fillColor=#fff5e6;strokeColor=#e0b070;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="836" width="490" height="64" as="geometry"/></mxCell><mxCell id="r6" value="7. A new domain" style="rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="200" height="64" as="geometry"/></mxCell><mxCell id="t6" value='&lt;font color="#b85450"&gt;&lt;b&gt;✗&lt;/b&gt;&lt;/font&gt; more guessing rules in screens.py and access.py, which can break other apps' style="rounded=0;fillColor=#f5f5f5;strokeColor=#bbbbbb;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="900" width="480" height="64" as="geometry"/></mxCell><mxCell id="n6" value='&lt;font color="#2d7d46"&gt;&lt;b&gt;✓&lt;/b&gt;&lt;/font&gt; a new domain folder and its types; features are reused (comments also serve news and learning)' style="rounded=0;fillColor=#fff5e6;strokeColor=#e0b070;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="900" width="490" height="64" as="geometry"/></mxCell><mxCell id="r7" value="8. User feedback (33.14)" style="rounded=0;fillColor=#ffffff;strokeColor=#bbbbbb;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="964" width="200" height="64" as="geometry"/></mxCell><mxCell id="t7" value='&lt;font color="#b85450"&gt;&lt;b&gt;✗&lt;/b&gt;&lt;/font&gt; edit the requirement and generate again' style="rounded=0;fillColor=#f5f5f5;strokeColor=#bbbbbb;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="964" width="480" height="64" as="geometry"/></mxCell><mxCell id="n7" value='&lt;font color="#2d7d46"&gt;&lt;b&gt;✓&lt;/b&gt;&lt;/font&gt; pin a comment on the preview → a change of choices (placement, option, label) in about two minutes, or a plugin request' style="rounded=0;fillColor=#fff5e6;strokeColor=#e0b070;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="964" width="490" height="64" as="geometry"/></mxCell><mxCell id="gw" value="The video page, as the member sees it" style="rounded=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=13;spacingTop=4;" vertex="