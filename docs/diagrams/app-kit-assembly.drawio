<mxfile host="drawio"><diagram id="app-kit" name="App kit assembly"><mxGraphModel dx="1250" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="How the app kit builds the UI: a yarn shop (storefront) example" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="g1" value="1. Picking: before the kit runs" style="rounded=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=13;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="330" height="900" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Requirement&lt;/b&gt;&lt;br&gt;“a yarn and fabric shop: shoppers browse, add to a cart with quantities, pay; the owner ships. Crisp, minimal, Scandinavian, one moss green accent”" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="290" height="100" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Code offers the choices&lt;/b&gt;&lt;br&gt;archetype_candidates ranks the archetypes from the words; design_choices lists only the registry’s plugins for them" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="290" height="85" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;The model picks&lt;/b&gt; (draft_app, one turn)&lt;br&gt;area Shop: &lt;i&gt;storefront&lt;/i&gt;, shell &lt;i&gt;topbar&lt;/i&gt;, home &lt;i&gt;catalogue&lt;/i&gt;&lt;br&gt;Product: list &lt;i&gt;media-grid&lt;/i&gt;, detail &lt;i&gt;media-side&lt;/i&gt;, card &lt;i&gt;stacked&lt;/i&gt;, filters &lt;i&gt;chips&lt;/i&gt;&lt;br&gt;looks: &lt;i&gt;minimal&lt;/i&gt; + fonts &lt;i&gt;workshop&lt;/i&gt;; colour #2e5a44" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="355" width="290" height="125" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;complete_design checks needs&lt;/b&gt;&lt;br&gt;each plugin’s needs (an image, a date…); a choice the data can’t fill falls back: CartItem card &lt;i&gt;side&lt;/i&gt; needs an image → &lt;i&gt;stacked&lt;/i&gt;" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="290" height="95" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;The pattern places things&lt;/b&gt; (storefront)&lt;br&gt;menu: Catalogue · My Cart · My Orders&lt;br&gt;Add to cart on the product; no dashboard, no tables, no edit of products" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="635" width="290" height="95" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b&gt;Planner → files&lt;/b&gt;&lt;br&gt;screens.py writes pages + sections; files.py writes &lt;b&gt;app.json&lt;/b&gt; and &lt;b&gt;design-registry.ts&lt;/b&gt; (only the plugins used)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="290" height="85" as="geometry"/></mxCell><mxCell id="f1" value="app.json · design-registry.ts · bindings.ts · mocks" style="shape=document;size=0.12;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="875" width="290" height="60" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="p6" target="f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g2" value="2. Assembling: the kit at runtime (/products/[id])" style="rounded=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=13;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="380" y="70" width="400" height="900" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;① AppShell&lt;/b&gt;&lt;br&gt;useLayout(path) → area “Shop”&lt;br&gt;designRegistry.shells[“topbar”] → &lt;b&gt;TopBarShell&lt;/b&gt;&lt;br&gt;menu items from the pattern" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="360" height="90" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;AppPage&lt;/b&gt;(pageId)&lt;br&gt;signed in? role allowed? then the page’s sections, grouped: one · figures grid · tabs" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="400" y="230" width="360" height="75" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;AppSection&lt;/b&gt;: switch on section.component&lt;br&gt;AppList · AppDetail · AppForm · AppDashboard · AppActions · AppAuth · AppPayment&lt;br&gt;(a section on an operation the user can’t call is left out)" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="400" y="335" width="360" height="95" as="geometry"/></mxCell><mxCell id="k4" value="&lt;b&gt;② AppDetail&lt;/b&gt; (the product)&lt;br&gt;designRegistry.detailViews[“media-side”] → &lt;b&gt;MediaSideDetail&lt;/b&gt;&lt;br&gt;fields by role: media, title, price, badge, meta" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="400" y="460" width="360" height="85" as="geometry"/></mxCell><mxCell id="k5" value="&lt;b&gt;③ RecordActions&lt;/b&gt;&lt;br&gt;buttons from the record’s &lt;b&gt;allowedActions&lt;/b&gt; → “Add to cart”; its form (quantity) opens in a dialog: &lt;b&gt;AppForm&lt;/b&gt; + the form kit" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="400" y="575" width="360" height="85" as="geometry"/></mxCell><mxCell id="k6" value="&lt;b&gt;④ AppList&lt;/b&gt; → &lt;b&gt;RecordsView&lt;/b&gt;&lt;br&gt;home? designRegistry.homes[“catalogue”] · else listViews[“media-grid”] → each record a cards[“stacked”] &lt;b&gt;StackedCard&lt;/b&gt;" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="400" y="690" width="360" height="85" as="geometry"/></mxCell><mxCell id="k7" value="&lt;b&gt;bindings.ts&lt;/b&gt; (typed client from the contract)&lt;br&gt;React Query → the live API, or the MSW mocks before the backend is up" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="400" y="805" width="360" height="75" as="geometry"/></mxCell><mxCell id="k8" value="Theme: recipe &lt;i&gt;minimal&lt;/i&gt;, fonts &lt;i&gt;workshop&lt;/i&gt;, accent #2e5a44 → globals.css tokens" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="400" y="900" width="360" height="50" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1" target="k1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365" y="905"/><mxPoint x="365" y="155"/></Array></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="k1" target="k2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="k2" target="k3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="k3" target="k4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="k4" target="k5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="k5" target="k6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="k6" target="k7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g3" value="3. What the shopper sees: the product page" style="rounded=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontStyle=1;fontSize=13;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="810" y="70" width="420" height="530" as="geometry"/></mxCell><mxCell id="wf" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="830" y="110" width="380" height="470" as="geometry"/></mxCell><mxCell id="wtop" value="&lt;b&gt;Thread &amp;amp; Needle&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; Catalogue&amp;nbsp;&amp;nbsp; My Cart&amp;nbsp;&amp;nbsp; My Orders&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 👤" style="rounded=0;fillColor=#f8f9fa;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="110" width="380" height="40" as="geometry"/></mxCell><mxCell id="wimg" value="photo" style="rounded=0;fillColor=#e6e6e6;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="845" y="170" width="170" height="170" as="geometry"/></mxCell><mxCell id="wtxt" value="&lt;b&gt;Merino DK – Moss&lt;/b&gt;&lt;br&gt;€12.50&lt;br&gt;&lt;i&gt;Yarn&lt;/i&gt; · DK · Moss&lt;br&gt;In stock: 34" style="rounded=0;fillColor=#f8f9fa;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1025" y="170" width="170" height="110" as="geometry"/></mxCell><mxCell id="wbtn" value="Add to cart" style="rounded=1;fillColor=#2e5a44;strokeColor=#2e5a44;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1025" y="295" width="120" height="30" as="geometry"/></mxCell><mxCell id="wdlg" value="&lt;b&gt;Add to cart&lt;/b&gt;&lt;br&gt;Quantity [ 2 ]&amp;nbsp;&amp;nbsp; [Add]" style="rounded=0;fillColor=#f8f9fa;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="360" width="165" height="60" as="geometry"/></mxCell><mxCell id="wlist" value="&lt;b&gt;Your cart lines for this product&lt;/b&gt;&lt;br&gt;Merino DK – Moss · 2 · €12.50" style="rounded=0;fillColor=#f8f9fa;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="845" y="440" width="350" height="60" as="geometry"/></mxCell><mxCell id="wnote" value="Tabs, figures and other sections stack below in the same way." style="text;html=1;fontSize=10;fontStyle=2;fontColor=#b85450;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="845" y="520" width="350" height="40" as="geometry"/></mxCell><mxCell id="t1" value="① TopBarShell" style="text;html=1;fontSize=10;fontStyle=2;fontColor=#b85450;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1125" y="152" width="90" height="18" as="geometry"/></mxCell><mxCell id="t2" value="② MediaSideDetail" style="text;html=1;fontSize=10;fontStyle=2;fontColor=#b85450;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="845" y="342" width="120" height="18" as="geometry"/></mxCell><mxCell id="t3" value="③ RecordActions" style="text;html=1;fontSize=10;fontStyle=2;fontColor=#b85450;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1110" y="325" width="90" height="18" as="geometry"/></mxCell><mxCell id="t4" value="③ AppForm in a dialog" style="text;html=1;fontSize=10;fontStyle=2;fontColor=#b85450;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1030" y="422" width="140" height="18" as="geometry"/></mxCell><mxCell id="t5" value="④ AppList → StackedCard" style="text;html=1;fontSize=10;fontStyle=2;fontColor=#b85450;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="845" y="502" width="160" height="18" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;■ blue: the user’s words&amp;nbsp; ■ purple: the model’s pick&lt;br&gt;■ green: code (checks, pattern, planner)&lt;br&gt;■ yellow: the kit’s React components&lt;br&gt;red tags ①–④: the kit component (column 2) that draws that part" style="rounded=0;fillColor=#f8f9fa;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="620" width="420" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
