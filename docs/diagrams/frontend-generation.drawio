<mxfile host="drawio"><diagram id="frontend-generation" name="Frontend generation"><mxGraphModel dx="1200" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Frontend generation (dynamic app, one-click flow)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="40" as="geometry"/></mxCell><mxCell id="gd" value="Before generation: the spec draft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="290" height="650" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;Requirement&lt;/b&gt;&lt;br&gt;typed in the UI (one-click)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="60" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;draft_app@v9&lt;/b&gt; (one LLM turn)&lt;br&gt;BackendSpec + app outline&lt;br&gt;(areas, archetype, looks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="250" height="80" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;Code fixes&lt;/b&gt;&lt;br&gt;defaults, person links, media,&lt;br&gt;access rules; repair_spec if invalid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="250" height="80" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;complete_outline&lt;/b&gt;&lt;br&gt;+ ensure_aggregates&lt;br&gt;(dashboard figures)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="250" height="70" as="geometry"/></mxCell><mxCell id="d5" value="&lt;b&gt;app_frontend_spec&lt;/b&gt; (code)&lt;br&gt;screens, forms, bindings from&lt;br&gt;product patterns + design plugins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="250" height="80" as="geometry"/></mxCell><mxCell id="d6" value="&lt;b&gt;FrontendSpec + BackendSpec&lt;/b&gt;&lt;br&gt;→ Generate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="250" height="60" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b&gt;1. validate_inputs&lt;/b&gt;&lt;br&gt;both specs valid?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="350" y="110" width="290" height="60" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;2. build_contract&lt;/b&gt;&lt;br&gt;contract.json: the one API truth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="350" y="200" width="290" height="60" as="geometry"/></mxCell><mxCell id="gf" value="Frontend lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="290" width="490" height="690" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;3. plan_frontend&lt;/b&gt;&lt;br&gt;rendering = app | renderer | engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="350" y="330" width="290" height="60" as="geometry"/></mxCell><mxCell id="f4" value="&lt;b&gt;4. scaffold_frontend&lt;/b&gt;&lt;br&gt;pinned Next.js base + overlay + app kit;&lt;br&gt;app.json, bindings.ts, MSW mocks,&lt;br&gt;plugin parts, theme, design registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="350" y="420" width="290" height="90" as="geometry"/></mxCell><mxCell id="f5" value="&lt;b&gt;5. generate_frontend&lt;/b&gt;&lt;br&gt;app: no engine call (kit renders)&lt;br&gt;renderer: custom components only&lt;br&gt;engine: shell + one call per page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="350" y="540" width="290" height="90" as="geometry"/></mxCell><mxCell id="f6" value="&lt;b&gt;6. validate_frontend&lt;/b&gt; (sandbox)&lt;br&gt;autofix, then install → typecheck,&lt;br&gt;lint → build → routes, assets,&lt;br&gt;conventions, scenarios, tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="350" y="660" width="290" height="90" as="geometry"/></mxCell><mxCell id="dia" value="checks&lt;br&gt;pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="435" y="780" width="120" height="80" as="geometry"/></mxCell><mxCell id="f7" value="&lt;b&gt;7. repair_frontend&lt;/b&gt;&lt;br&gt;engine fixes the&lt;br&gt;failed checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="680" y="660" width="120" height="90" as="geometry"/></mxCell><mxCell id="f8" value="&lt;b&gt;Frontend preview&lt;/b&gt;&lt;br&gt;running on the mocks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="350" y="890" width="290" height="60" as="geometry"/></mxCell><mxCell id="be" value="&lt;b&gt;Backend lane&lt;/b&gt; (in parallel)&lt;br&gt;&lt;br&gt;plan_architecture&lt;br&gt;→ generate_database&lt;br&gt;→ generate_backend&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(CRUD by code, engine fills gaps)&lt;br&gt;→ run_validation ⇄ repair_code&lt;br&gt;→ backend preview" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="850" y="330" width="260" height="160" as="geometry"/></mxCell><mxCell id="g9" value="&lt;b&gt;8. integrate&lt;/b&gt;&lt;br&gt;backend up? switch frontend to the live API,&lt;br&gt;else keep the mocks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="350" y="1010" width="290" height="70" as="geometry"/></mxCell><mxCell id="g10" value="&lt;b&gt;9. package_artifacts&lt;/b&gt;&lt;br&gt;frontend.zip, runtime image, report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="350" y="1110" width="290" height="60" as="geometry"/></mxCell><mxCell id="g11" value="&lt;b&gt;10. evaluation&lt;/b&gt; (after completion)&lt;br&gt;each role's tour walked in a browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="350" y="1200" width="290" height="60" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;■ blue: drafting (before the job)&lt;br&gt;■ purple: an LLM / engine call&lt;br&gt;■ green: frontend lane, code&lt;br&gt;■ orange: backend lane&lt;br&gt;■ grey: job steps" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;size=14;" vertex="1" parent="1"><mxGeometry x="700" y="1110" width="250" height="110" as="geometry"/></mxCell><mxCell id="st" value="&lt;b&gt;Static mode&lt;/b&gt; (a site, no backend)&lt;br&gt;validate_inputs → plan → scaffold&lt;br&gt;→ generate → package.&lt;br&gt;No contract, no checks, no integrate." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;size=14;" vertex="1" parent="1"><mxGeometry x="970" y="1110" width="260" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="d5" target="d6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;h