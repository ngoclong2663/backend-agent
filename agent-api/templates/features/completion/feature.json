{
  "name": "completion",
  "status": "ready",
  "label": "Completion",
  "attachesTo": "lesson",
  "choose": "People mark a part (a lesson) done; its whole (the course) shows their progress.",
  "replaces": [
    "progress",
    "completion"
  ],
  "options": {
    "course": {
      "default": "Course"
    },
    "courseField": {
      "default": "courseId"
    },
    "personField": {
      "default": "learnerId"
    }
  },
  "spec": {
    "entities": [
      {
        "name": "{Target}Completion",
        "fields": [
          {
            "name": "id",
            "type": "uuid",
            "primary": true
          },
          {
            "name": "{target}Id",
            "type": "uuid",
            "required": true,
            "index": true
          },
          {
            "name": "{courseField}",
            "type": "uuid",
            "required": true,
            "index": true
          },
          {
            "name": "{personField}",
            "type": "uuid",
            "required": true,
            "index": true
          },
          {
            "name": "completedAt",
            "type": "datetime",
            "required": true,
            "default": "now"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "{target}Completions",
        "type": "one-to-many",
        "from": "{Target}",
        "to": "{Target}Completion",
        "foreignKey": "{target}Id",
        "onDelete": "CASCADE"
      }
    ],
    "operations": [
      {
        "operationId": "{target}Completion.create",
        "type": "crud",
        "action": "create",
        "entity": "{Target}Completion",
        "method": "POST",
        "path": "/{targetPath}-completions",
        "auth": "jwt",
        "policy": "own{Target}Completions"
      },
      {
        "operationId": "{target}Completion.delete",
        "type": "crud",
        "action": "delete",
        "entity": "{Target}Completion",
        "method": "DELETE",
        "path": "/{targetPath}-completions/{id}",
        "auth": "jwt",
        "policy": "own{Target}Completions"
      }
    ],
    "policies": [
      {
        "name": "own{Target}Completions",
        "type": "ownership",
        "entity": "{Target}Completion",
        "ownerField": "{personField}"
      }
    ],
    "rules": [
      {
        "id": "one{Target}CompletionEach",
        "kind": "uniqueTogether",
        "entity": "{Target}Completion",
        "params": {
          "fields": [
            "{target}Id",
            "{personField}"
          ]
        }
      }
    ]
  },
  "computed": [
    {
      "field": "myCompletionId",
      "kind": "mine",
      "entity": "{Target}Completion",
      "key": "{target}Id",
      "owner": "{personField}"
    },
    {
      "field": "myCompletedCount",
      "kind": "count",
      "entity": "{Target}Completion",
      "key": "{courseField}",
      "owner": "{personField}",
      "target": "{course}"
    },
    {
      "field": "{target}Count",
      "kind": "count",
      "entity": "{Target}",
      "key": "{courseField}",
      "target": "{course}"
    }
  ],
  "kit": {
    "slots": [
      "progress-bar"
    ],
    "toggles": [
      {
        "id": "complete",
        "label": "Mark complete",
        "reaction": "complete",
        "create": "{target}Completion.create",
        "undo": "{target}Completion.delete",
        "state": "myCompletionId",
        "body": {
          "{target}Id": "{record}",
          "{courseField}": "$record.{courseField}"
        }
      }
    ]
  }
}
