          "type": "uuid"
        },
        {
          "default": "counted",
          "name": "status",
          "required": true,
          "type": "enum",
          "values": [
            "counted"
          ]
        },
        {
          "default": "now",
          "name": "createdAt",
          "required": true,
          "type": "datetime"
        }
      ],
      "name": "View"
    },
    {
      "displayField": "recipeId",
