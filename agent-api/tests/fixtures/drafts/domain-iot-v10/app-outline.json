  "workflows": {
    "version": "bffe6e83c4da",
    "tours": [
      {
        "id": "respond_to_alerts",
        "name": "Respond to Alerts",
        "outcome": "Triggered greenhouse environmental or pest alert is reviewed and acknowledged.",
        "roles": [
          "admin",
          "operator"
        ],
        "steps": [
          {
            "id": "detect_breach",
            "role": "admin",
            "actor": "Greenhouse Administrator",
            "title": "Record threshold breach when sensor reading or pest detection meets rule condition (the alert becomes triggered). Rule: Condition must persist for configured duration or meet confidence threshold",
            "operationId": "alert.recordBreach",
            "statusAfter": "triggered",
            "page": "admins-alerts",
            "route": "/admins/alerts",
            "target": {
              "section": "alerts-actions",
              "action": "record-breach"
            },
            "kind": "do",
            "record": "alert"
          },
          {
            "id": "review_alert",
            "role": "operator",
            "actor": "Greenhouse Operator",
            "title": "View alert details and recent zone history on dashboard (the alert becomes viewed)",
            "operationId": "alert.view",
            "statusAfter": "viewed",
            "page": "alerts-id",
            "route": "/alerts/[id]",
            "target": {
              "section": "alerts-detail",
              "action": "view"
            },
            "kind": "do",
            "record": "alert",
            "needs": {
              "step": "detect_breach",
              "role": "admin",
              "status": "triggered"
            }
          },
          {
            "id": "ack_alert",
            "role": "operator",
            "actor": "Greenhouse Operator",
            "title": "Acknowledge alert to confirm awareness and ongoing response (the alert becomes acknowledged). Rule: Operator must be signed in",
            "operationId": "alert.acknowledge",
            "statusAfter": "acknowledged",
            "page": "alerts-id",
            "route": "/alerts/[id]",
            "target": {
              "section": "alerts-detail",
              "action": "acknowledge"
            },
            "kind": "do",
            "record": "alert",
            "needs": {
              "step": "review_alert",
              "role": "operator",
              "status": "viewed"
            }
          }
        ]
      },
      {
        "id": "review_pest_detections",
        "name": "Review Pest Detections",
        "outcome": "Camera pest detection snapshot is validated or dismissed.",
        "roles": [
          "operator"
        ],
        "steps": [
          {
            "id": "ingest_detection",
            "role": "operator",
            "actor": "Greenhouse Operator",
            "title": "Receive camera snapshot with detected pest and confidence score (the detection becomes pending). Rule: Snapshot must include identified pest and confidence score",
            "operationId": "pestDetection.create",
            "statusAfter": "pending",
            "page": "devices-id-pest-detections-new",
            "route": "/devices/[id]/pest-detections/new",
            "target": {
              "section": "pest-detection-create-in-device-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "detection"
          },
          {
            "id": "review_detection",
            "role": "operator",
            "actor": "Greenhouse Operator",
            "title": "Review detection snapshot and confidence score (the detection becomes reviewed)",
            "operationId": "pestDetection.review",
            "statusAfter": "reviewed",
            "page": "pest-detections-id",
            "route": "/pest-detections/[id]",
            "target": {
              "section": "pest-detections-detail",
              "action": "review"
            },
            "kind": "do",
            "record": "detection",
            "needs": {
              "step": "ingest_detection",
              "role": "operator",
              "status": "pending"
            }
          },
          {
            "id": "confirm_detection",
            "role": "operator",
            "actor": "Greenhouse Operator",
            "title": "Confirm pest presence for targeted treatment (the detection becomes confirmed). Rule: Operator must verify image details",
            "operationId": "pestDetection.confirm",
            "statusAfter": "confirmed",
            "page": "pest-detections-id",
            "route": "/pest-detections/[id]",
            "target": {
              "section": "pest-detections-detail",
              "action": "confirm"
            },
            "kind": "do",
            "record": "detection",
            "needs": {
              "step": "review_detection",
              "role": "operator",
              "status": "reviewed"
            }
          }
        ]
      },
      {
        "id": "manage_device_health",
        "name": "Manage Device Health",
        "outcome": "Unresponsive or low-health device is identified and issued a reboot command.",
        "roles": [
          "admin",
          "operator"
        ],
        "steps": [
          {
            "id": "inspect_device_status",
            "role": "operator",
            "actor": "Greenhouse Operator",
            "title": "Check dashboard for offline devices and low battery indicators (the device becomes flagged)",
            "operationId": "device.flag",
            "statusAfter": "flagged",
            "page": "devices-id",
            "route": "/devices/[id]",
            "target": {
              "section": "devices-detail",
              "action": "flag"
            },
            "kind": "do",
            "record": "device"
          },
          {
            "id": "reboot_device",
            "role": "admin",
            "actor": "Greenhouse Administrator",
            "title": "Send reboot command to unresponsive device (the device becomes rebooting). Rule: Only administrators can issue device commands",
            "operationId": "device.reboot",
            "statusAfter": "rebooting",
            "page": "admins-devices-id",
            "route": "/admins/devices/[id]",
            "target": {
              "section": "devices-detail",
              "action": "reboot"
            },
            "kind": "do",
            "record": "device",
            "needs": {
              "step": "inspect_device_status",
              "role": "operator",
              "status": "flagged"
            }
          }
        ]
      }
    ]
  }
}
