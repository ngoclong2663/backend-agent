  "dashboard": [
    {
      "label": "Open Offers",
      "kind": "figure",
      "entity": "Delivery",
      "fn": "count",
      "filter": {
        "status": "offered"
      }
    },
    {
      "label": "Delivered Today",
      "kind": "figure",
      "entity": "Delivery",
      "fn": "count",
      "filter": {
        "status": "delivered"
      },
      "period": "day"
    },
    {
      "label": "Drivers Online",
      "kind": "figure",
      "entity": "DriverProfile",
      "fn": "count",
      "filter": {
        "isOnline": true
      }
    },
    {
      "label": "Deliveries by Status",
      "kind": "bar",
      "entity": "Delivery",
      "fn": "count",
      "filter": {},
      "groupBy": "status"
    },
    {
      "label": "Earnings Today",
      "kind": "figure",
