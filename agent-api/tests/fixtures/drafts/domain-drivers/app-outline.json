      "fn": "sum",
      "field": "fee",
      "filter": {
        "status": "delivered"
      },
      "period": "week",
      "dateField": "deliveredAt"
    }
  ],
  "workflows": {
    "version": "986669417579",
    "tours": [
      {
        "id": "order_fulfillment",
        "name": "Parcel Order and Fulfillment",
        "outcome": "The parcel is delivered to the customer with photographic proof",
        "roles": [
          "driver",
          "shop"
        ],
        "steps": [
          {
            "id": "create_delivery",
            "role": "shop",
            "actor": "Shop",
            "title": "Create delivery request (the delivery becomes offered). Rule: Must include pickup address, drop-off address, customer name, phone, and parcel size",
            "operationId": "delivery.create",
            "statusAfter": "offered",
            "page": "deliveries-new",
            "route": "/deliveries/new",
            "target": {
              "section": "delivery-create-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "delivery"
          },
          {
            "id": "accept_offer",
            "role": "driver",
            "actor": "Driver",
            "title": "Accept delivery offer (the delivery becomes assigned). Rule: Driver must be online, carry only one delivery at a time, and offer not already taken",
            "operationId": "delivery.accept",
            "statusAfter": "assigned",
            "page": "driver-deliveries-id",
            "route": "/driver/deliveries/[id]",
            "target": {
              "section": "deliveries-detail",
              "action": "accept"
            },
            "kind": "do",
            "record": "delivery",
            "needs": {
              "step": "create_delivery",
              "role": "shop",
              "status": "offered"
            }
          },
          {
            "id": "start_pickup",
            "role": "driver",
            "actor": "Driver",
            "title": "Start traveling to pickup (the delivery becomes going_to_pickup)",
            "operationId": "delivery.startGoingToPickup",
            "statusAfter": "going_to_pickup",
            "page": "driver-deliveries-id",
            "route": "/driver/deliveries/[id]",
            "target": {
              "section": "deliveries-detail",
              "action": "start-going-to-pickup"
            },
            "kind": "do",
            "record": "delivery",
            "needs": {
              "step": "accept_offer",
              "role": "driver",
              "status": "assigned"
            }
          },
          {
            "id": "confirm_pickup",
            "role": "driver",
            "actor": "Driver",
            "title": "Confirm parcel picked up (the delivery becomes picked_up)",
            "operationId": "delivery.confirmPickedUp",
            "statusAfter": "picked_up",
            "page": "driver-deliveries-id",
            "route": "/driver/deliveries/[id]",
            "target": {
              "section": "deliveries-detail",
              "action": "confirm-picked-up"
            },
            "kind": "do",
            "record": "delivery",
            "needs": {
              "step": "start_pickup",
              "role": "driver",
              "status": "going_to_pickup"
            }
          },
          {
            "id": "start_dropoff",
            "role": "driver",
            "actor": "Driver",
            "title": "Start traveling to drop-off (the delivery becomes going_to_dropoff)",
            "operationId": "delivery.startGoingToDropoff",
            "statusAfter": "going_to_dropoff",
            "page": "driver-deliveries-id",
            "route": "/driver/deliveries/[id]",
            "target": {
              "section": "deliveries-detail",
              "action": "start-going-to-dropoff"
            },
            "kind": "do",
            "record": "delivery",
            "needs": {
              "step": "confirm_pickup",
              "role": "driver",
              "status": "picked_up"
            }
          },
          {
            "id": "complete_delivery",
            "role": "driver",
            "actor": "Driver",
            "title": "Complete delivery with proof photo (the delivery becomes delivered). Rule: Photo of parcel at door is mandatory",
            "operationId": "delivery.completeDelivery",
            "statusAfter": "delivered",
            "page": "driver-deliveries-id",
            "route": "/driver/deliveries/[id]",
            "target": {
              "section": "deliveries-detail",
              "action": "complete-delivery"
            },
            "kind": "do",
            "record": "delivery",
            "needs": {
              "step": "start_dropoff",
              "role": "driver",
              "status": "going_to_dropoff"
            }
          }
        ]
      },
      {
        "id": "track_delivery",
        "name": "Customer Delivery Tracking",
        "outcome": "Customer stays informed of parcel delivery progress",
        "roles": [],
        "steps": [
          {
            "id": "view_progress",
            "role": null,
            "actor": "Customer",
            "title": "View delivery progress",
            "operationId": null,
            "skip": "no app role plays this actor",
            "kind": "note",
            "record": "delivery"
          }
        ]
      },
      {
        "id": "track_earnings",
        "name": "Driver Earnings Review",
        "outcome": "Driver verifies income earned today and this week",
        "roles": [
          "driver"
        ],
        "steps": [
          {
            "id": "view_earnings",
            "role": "driver",
            "actor": "Driver",
            "title": "View daily and weekly earnings. Rule: Only completed deliveries are counted toward earnings",
            "operationId": "delivery.sumFeeThisDayOnDeliveredAtWhereStatusDelivered",
            "page": "driver-dashboard",
            "route": "/driver/dashboard",
            "target": {
              "section": "figure-5",
              "action": null
            },
            "kind": "look",
            "record": "delivery"
          }
        ]
      },
      {
        "id": "dispatch_oversight",
        "name": "Dispatcher Delivery Oversight",
        "outcome": "Dispatcher monitors operations and driver availability",
        "roles": [
          "dispatcher"
        ],
        "steps": [
          {
            "id": "monitor_network",
            "role": "dispatcher",
            "actor": "Dispatcher",
            "title": "View deliveries by status and online drivers",
            "operationId": "delivery.countByStatus",
            "page": "dispatcher-home",
            "route": "/dispatcher",
            "target": {
              "section": "figure-4",
              "action": null
            },
            "kind": "look",
            "record": "delivery"
          }
        ]
      }
    ]
  }
}
