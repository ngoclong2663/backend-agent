  "workflows": {
    "version": "0c045cf852a0",
    "tours": [
      {
        "id": "publish_article",
        "name": "Publish Article",
        "outcome": "An article is reviewed and published for public readership",
        "roles": [
          "Editor",
          "Writer"
        ],
        "steps": [
          {
            "id": "draft_article",
            "role": "Writer",
            "actor": "Writer",
            "title": "Draft article in section (the article becomes draft). Rule: Section must be City, Business, Culture, or Sport",
            "operationId": "article.create",
            "statusAfter": "draft",
            "page": "writers-articles-new",
            "route": "/writers/articles/new",
            "target": {
              "section": "article-create-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "article"
          },
          {
            "id": "submit_draft",
            "role": "Writer",
            "actor": "Writer",
            "title": "Submit draft for review (the article becomes submitted). Rule: Headline, section, and body cannot be empty",
            "operationId": "article.submit",
            "statusAfter": "submitted",
            "page": "writers-articles-id",
            "route": "/writers/articles/[id]",
            "target": {
              "section": "articles-detail",
              "action": "submit"
            },
            "kind": "do",
            "record": "article",
            "needs": {
              "step": "draft_article",
              "role": "Writer",
              "status": "draft"
            }
          },
          {
            "id": "review_draft",
            "role": "Editor",
            "actor": "Editor",
            "title": "Review submitted draft (the article becomes under_review). Rule: Must verify factual integrity and editorial tone",
            "operationId": "article.review",
            "statusAfter": "under_review",
            "page": "editors-articles-id",
            "route": "/editors/articles/[id]",
            "target": {
              "section": "articles-detail",
              "action": "review"
            },
            "kind": "do",
            "record": "article",
            "needs": {
              "step": "submit_draft",
              "role": "Writer",
              "status": "submitted"
            }
          },
          {
            "id": "publish_article_step",
            "role": "Editor",
            "actor": "Editor",
            "title": "Publish article (the article becomes published). Rule: Only submitted or reviewed drafts can be published",
            "operationId": "article.publish",
            "statusAfter": "published",
            "page": "editors-articles-id",
            "route": "/editors/articles/[id]",
            "target": {
              "section": "articles-detail",
              "action": "publish"
            },
            "kind": "do",
            "record": "article",
            "needs": {
              "step": "review_draft",
              "role": "Editor",
              "status": "under_review"
            }
          }
        ]
      },
      {
        "id": "read_and_comment",
        "name": "Read and Comment on Article",
        "outcome": "A reader reads a story and adds their perspective to the article discussion",
        "roles": [
          "Reader"
        ],
        "steps": [
          {
            "id": "view_article",
            "role": "Reader",
            "actor": "Reader",
            "title": "View front page and select article. Rule: Only published articles are visible",
            "operationId": "article.get",
            "page": "articles-id",
            "route": "/articles/[id]",
            "target": {
              "section": "articles-detail",
              "action": null
            },
            "kind": "look",
            "record": "article"
          },
          {
            "id": "post_comment",
            "role": "Reader",
            "actor": "Reader",
            "title": "Post comment on article (the comment becomes posted). Rule: Comments can only be posted on published articles",
            "operationId": "comment.create",
            "statusAfter": "posted",
            "page": "articles-id",
            "route": "/articles/[id]",
            "target": {
              "section": "articles-detail",
              "action": "add-comments"
            },
            "kind": "do",
            "record": "comment"
          }
        ]
      },
      {
        "id": "bookmark_and_follow",
        "name": "Bookmark Article and Follow Section",
        "outcome": "Articles are saved for later reading and sections are followed for curated discovery",
        "roles": [
          "Reader"
        ],
        "steps": [
          {
            "id": "bookmark_article",
            "role": "Reader",
            "actor": "Reader",
            "title": "Bookmark article to read later (the bookmark becomes bookmarked). Rule: Only published articles can be bookmarked",
            "operationId": "bookmark.create",
            "statusAfter": "bookmarked",
            "page": "articles-id",
            "route": "/articles/[id]",
            "target": {
              "section": "articles-detail",
              "action": "add-bookmarks"
            },
            "kind": "do",
            "record": "bookmark"
          },
          {
            "id": "follow_section",
            "role": "Reader",
            "actor": "Reader",
            "title": "Follow section (the follow becomes active). Rule: Section must be an existing active section",
            "operationId": "follow.create",
            "statusAfter": "active",
            "page": "follows-new",
            "route": "/follows/new",
            "target": {
              "section": "follow-create-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "follow"
          }
        ]
      }
    ]
  }
}
