    "workflows": {
      "version": "e3deb9cddee5",
      "tours": [
        {
          "id": "editorial_publishing",
          "name": "Publishing an article",
          "outcome": "Article is published and made available to readers",
          "roles": [
            "editor",
            "writer"
          ],
          "steps": [
            {
              "id": "draft_article",
              "role": "writer",
              "actor": "Writer",
              "title": "Draft article in section (the article becomes draft). Rule: Must select one valid section (City, Business, Culture, Sport)",
              "operationId": "article.create",
              "statusAfter": "draft",
              "page": "newsroom-articles-new",
              "route": "/newsroom/articles/new",
              "target": {
                "section": "article-create-form",
                "action": "submit"
              },
              "kind": "do",
              "record": "article"
            },
            {
              "id": "submit_draft",
              "role": "writer",
              "actor": "Writer",
              "title": "Submit draft for review (the article becomes under_review). Rule: Draft must have title, content, and section",
              "operationId": "article.submitForReview",
              "statusAfter": "under_review",
              "page": "newsroom-articles-id",
              "route": "/newsroom/articles/[id]",
              "target": {
                "section": "articles-detail",
                "action": "submit-for-review"
              },
              "kind": "do",
              "record": "article",
              "needs": {
                "step": "draft_article",
                "role": "writer",
                "status": "draft"
              }
            },
            {
              "id": "publish_article",
              "role": "editor",
              "actor": "Editor",
              "title": "Publish article (the article becomes published). Rule: Only articles under review can be published",
              "operationId": "article.publish",
              "statusAfter": "published",
              "page": "newsroom-articles-id",
              "route": "/newsroom/articles/[id]",
              "target": {
                "section": "articles-detail",
                "action": "publish"
              },
              "kind": "do",
              "record": "article",
              "needs": {
                "step": "submit_draft",
                "role": "writer",
                "status": "under_review"
              }
            }
          ]
        },
        {
          "id": "reader_reading_and_discussion",
          "name": "Reading and commenting on an article",
          "outcome": "Reader reads published news and contributes a comment",
          "roles": [
            "reader"
          ],
          "steps": [
            {
              "id": "view_front_page",
              "role": "reader",
              "actor": "Reader",
              "title": "View front page with lead story and section articles. Rule: Only published articles are visible",
              "operationId": "article.list",
              "page": "home",
              "route": "/",
              "target": {
                "section": "articles-list",
                "action": null
              },
              "kind": "look",
              "record": "article"
            },
            {
              "id": "read_article",
              "role": "reader",
              "actor": "Reader",
              "title": "Read full article. Rule: Article must be published",
              "operationId": "article.get",
              "page": "articles-id",
              "route": "/articles/[id]",
              "target": {
                "section": "articles-detail",
                "action": null
              },
              "kind": "look",
              "record": "article"
            },
            {
              "id": "post_comment",
              "role": "reader",
              "actor": "Reader",
              "title": "Post comment on article (the comment becomes published). Rule: Comment text cannot be empty",
              "operationId": "articleComment.create",
              "statusAfter": "published",
              "page": "articles-id",
              "route": "/articles/[id]",
              "skip": "no screen performs this step",
              "kind": "note",
              "record": "comment"
            }
          ]
        }
      ]
    }
  },
