  "workflows": {
    "version": "5ba39e869da2",
    "tours": [
      {
        "id": "publish_recipe",
        "name": "Publish Recipe",
        "outcome": "A new recipe video is shared and available for community members to watch",
        "roles": [
          "Cook"
        ],
        "steps": [
          {
            "id": "draft_recipe",
            "role": "Cook",
            "actor": "Cook",
            "title": "Drafts a recipe with title, video, cover photo, cooking time, and ingredients (the recipe becomes draft). Rule: All fields including video, cover photo, cooking time, and ingredients must be provided",
            "operationId": "recipe.create",
            "statusAfter": "draft",
            "page": "recipes-new",
            "route": "/recipes/new",
            "target": {
              "section": "recipe-create-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "recipe"
          },
          {
            "id": "publish_recipe_step",
            "role": "Cook",
            "actor": "Cook",
            "title": "Publishes the recipe to the community feed (the recipe becomes published)",
            "operationId": "recipe.publish",
            "statusAfter": "published",
            "page": "recipes-id",
            "route": "/recipes/[id]",
            "target": {
              "section": "recipes-detail",
              "action": "publish"
            },
            "kind": "do",
            "record": "recipe",
            "needs": {
              "step": "draft_recipe",
              "role": "Cook",
              "status": "draft"
            }
          }
        ]
      },
      {
        "id": "discover_and_engage",
        "name": "Discover and Engage with Recipe",
        "outcome": "The recipe gains a view, engagement signals, and public community feedback",
        "roles": [
          "Member"
        ],
        "steps": [
          {
            "id": "open_recipe",
            "role": "Member",
            "actor": "Member",
            "title": "Opens a recipe to watch the video (the recipe becomes viewed). Rule: Opening a recipe increments its view count by one",
            "operationId": "recipe.recordView",
            "statusAfter": "viewed",
            "page": "members-recipes-id",
            "route": "/members/recipes/[id]",
            "target": {
              "section": "recipes-detail",
              "action": "record-view"
            },
            "kind": "do",
            "record": "recipe"
          },
          {
            "id": "react_recipe",
            "role": "Member",
            "actor": "Member",
            "title": "Likes or saves the recipe to cook later (the recipe becomes saved). Rule: Member must be signed in to like or save",
            "operationId": "recipeSave.create",
            "statusAfter": "saved",
            "page": "members-recipes-id",
            "route": "/members/recipes/[id]",
            "target": {
              "section": "recipes-detail",
              "action": "add-recipe-saves"
            },
            "kind": "do",
            "record": "recipe",
            "needs": {
              "step": "open_recipe",
              "role": "Member",
              "status": "viewed"
            }
          },
          {
            "id": "post_comment",
            "role": "Member",
            "actor": "Member",
            "title": "Writes a comment directly under the recipe (the comment becomes posted). Rule: Comments are public and visible to everyone reading the recipe",
            "operationId": "comment.create",
            "statusAfter": "posted",
            "page": "members-recipes-id",
            "route": "/members/recipes/[id]",
            "target": {
              "section": "recipes-detail",
              "action": "add-comments"
            },
            "kind": "do",
            "record": "comment"
          }
        ]
      },
      {
        "id": "monitor_studio",
        "name": "Monitor Recipe Performance in Studio",
        "outcome": "The cook evaluates recipe reach and manages their recipe catalog",
        "roles": [
          "Cook"
        ],
        "steps": [
          {
            "id": "review_performance",
            "role": "Cook",
            "actor": "Cook",
            "title": "Reviews view counts and engagement numbers for posted recipes. Rule: Studio only shows recipes and analytics belonging to the cook",
            "operationId": "recipe.get",
            "page": "recipes-id",
            "route": "/recipes/[id]",
            "target": {
              "section": "recipes-detail",
              "action": null
            },
            "kind": "look",
            "record": "recipe"
          }
        ]
      }
    ]
  }
