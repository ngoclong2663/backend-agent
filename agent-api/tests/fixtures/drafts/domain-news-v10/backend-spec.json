  "specVersion": "1.0",
  "stack": {
    "database": "postgresql",
    "framework": "fastapi",
    "migration": "alembic",
    "orm": "sqlmodel"
  },
  "features": [
    {
      "feature": "comments",
      "on": "Article",
      "options": {},
      "entities": [
        "ArticleComment"
      ],
      "computed": [
        {
          "field": "commentCount",
          "kind": "count",
          "entity": "ArticleComment",
          "key": "articleId",
          "where": {}
        }
      ]
    },
    {
      "feature": "reactions",
      "on": "Article",
      "options": {
        "kinds": [
          "save"
        ]
      },
      "entities": [
        "ArticleReaction"
      ],
      "computed": [
        {
          "field": "saveCount",
          "kind": "count",
          "entity": "ArticleReaction",
          "key": "articleId",
          "where": {
            "kind": "save"
          }
        },
        {
          "field": "mySaveId",
          "kind": "mine",
          "entity": "ArticleReaction",
          "key": "articleId",
          "where": {
            "kind": "save"
          },
          "owner": "userId"
        }
      ]
    },
    {
      "feature": "follow",
      "on": "Article",
      "options": {
        "subject": "Section",
        "subjectField": "section"
      },
      "entities": [
        "SectionFollow"
      ],
      "computed": [
        {
          "field": "mySectionFollowId",
          "kind": "mine",
          "entity": "SectionFollow",
          "key": "subject",
          "where": {},
          "owner": "followerId",
          "match": "section"
        },
        {
          "field": "sectionFollowerCount",
          "kind": "count",
          "entity": "SectionFollow",
          "key": "subject",
          "where": {},
          "match": "section"
        }
      ]
    }
  ]
}
