  "workflows": {
    "version": "a3a323dc6668",
    "tours": [
      {
        "id": "publish_article",
        "name": "Article drafting and publication",
        "outcome": "Article is published and available to readers",
        "roles": [
          "editor",
          "writer"
        ],
        "steps": [
          {
            "id": "draft_article",
            "role": "writer",
            "actor": "Writer",
            "title": "Draft article in section (the article becomes draft). Rule: Section must be City, Business, Culture, or Sport",
            "operationId": "article.create",
            "statusAfter": "draft",
            "page": "newsroom-articles-new",
            "route": "/newsroom/articles/new",
            "target": {
              "section": "article-create-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "article"
          },
          {
            "id": "submit_for_review",
            "role": "writer",
            "actor": "Writer",
            "title": "Submit article for review (the article becomes in_review). Rule: Draft must have headline and content",
            "operationId": "article.submitForReview",
            "statusAfter": "in_review",
            "page": "newsroom-articles-id",
            "route": "/newsroom/articles/[id]",
            "target": {
              "section": "articles-detail",
              "action": "submit-for-review"
            },
            "kind": "do",
            "record": "article",
            "needs": {
              "step": "draft_article",
              "role": "writer",
              "status": "draft"
            }
          },
          {
            "id": "editor_reviews",
            "role": "editor",
            "actor": "Editor",
            "title": "Review article draft (the article becomes in_review). Rule: Only in-review articles can be reviewed",
            "operationId": "article.get",
            "statusAfter": "in_review",
            "page": "newsroom-articles-id",
            "route": "/newsroom/articles/[id]",
            "target": {
              "section": "articles-detail",
              "action": null
            },
            "kind": "look",
            "record": "article"
          },
          {
            "id": "publish_draft",
            "role": "editor",
            "actor": "Editor",
            "title": "Publish article (the article becomes published). Rule: Only editors can publish",
            "operationId": "article.publish",
            "statusAfter": "published",
            "page": "newsroom-articles-id",
            "route": "/newsroom/articles/[id]",
            "target": {
              "section": "articles-detail",
              "action": "publish"
            },
            "kind": "do",
            "record": "article",
            "needs": {
              "step": "submit_for_review",
              "role": "writer",
              "status": "in_review"
            }
          }
        ]
      },
      {
        "id": "read_and_comment",
        "name": "Article reading and commenting",
        "outcome": "Reader has read an article and contributed a comment",
        "roles": [
          "reader"
        ],
        "steps": [
          {
            "id": "browse_news",
            "role": "reader",
            "actor": "Reader",
            "title": "Browse front page and section news. Rule: Readers only ever see published articles",
            "operationId": "article.list",
            "page": "home",
            "route": "/",
            "target": {
              "section": "articles-list",
              "action": null
            },
            "kind": "look",
            "record": "article"
          },
          {
            "id": "read_story",
            "role": "reader",
            "actor": "Reader",
            "title": "Read article. Rule: Article must be published",
            "operationId": "article.get",
            "page": "articles-id",
            "route": "/articles/[id]",
            "target": {
              "section": "articles-detail",
              "action": null
            },
            "kind": "look",
            "record": "article"
          },
          {
            "id": "post_comment",
            "role": "reader",
            "actor": "Reader",
            "title": "Post comment (the comment becomes posted). Rule: Comment text cannot be empty",
            "operationId": "articleComment.create",
            "statusAfter": "posted",
            "page": "articles-id",
            "route": "/articles/[id]",
            "skip": "no screen performs this step",
            "kind": "note",
            "record": "comment"
          }
        ]
      }
    ]
  }
