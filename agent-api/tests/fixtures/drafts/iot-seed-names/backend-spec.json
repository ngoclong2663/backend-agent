      "admin"
    ],
    "type": "jwt"
  },
  "entities": [
    {
      "displayField": "name",
      "fields": [
        {
          "name": "id",
          "primary": true,
          "type": "uuid"
        },
        {
          "maxLength": 100,
          "name": "name",
          "required": true,
          "type": "string",
          "unique": true
        },
        {
          "maxLength": 500,
          "name": "description",
          "nullable": true,
          "required": false,
          "type": "text"
        },
        {
          "default": "now",
          "name": "createdAt",
          "required": true,
          "type": "datetime"
        }
      ],
      "name": "Zone"
    },
    {
      "displayField": "name",
      "fields": [
        {
          "name": "id",
          "primary": true,
          "type": "uuid"
        },
        {
          "maxLength": 100,
          "name": "name",
          "required": true,
          "type": "string"
        },
        {
          "index": true,
          "name": "zoneId",
          "required": true,
          "type": "uuid"
        },
        {
          "name": "deviceType",
          "required": true,
          "type": "enum",
          "values": [
            "SENSOR",
            "CAMERA"
          ]
        },
        {
          "default": "NORMAL",
          "name": "status",
          "required": true,
          "type": "enum",
          "values": [
            "NORMAL",
            "FLAGGED",
            "REBOOTING"
          ]
        },
        {
          "default": 100,
          "max": 100,
          "min": 0,
          "name": "batteryLevel",
          "required": true,
          "type": "integer"
        },
        {
          "default": true,
          "name": "isOnline",
          "required": true,
          "type": "boolean"
        },
        {
          "default": "now",
          "name": "lastSeenAt",
          "required": true,
          "type": "datetime"
        },
        {
          "default": "now",
          "name": "createdAt",
          "required": true,
          "type": "datetime"
        }
      ],
      "name": "Device"
    },
    {
      "displayField": "recordedAt",
      "fields": [
        {
          "name": "id",
          "primary": true,
          "type": "uuid"
        },
        {
          "index": true,
          "name": "deviceId",
          "required": true,
          "type": "uuid"
        },
        {
          "index": true,
          "name": "zoneId",
          "required": true,
          "type": "uuid"
        },
        {
          "name": "temperature",
          "required": true,
          "type": "float"
        },
        {
          "name": "humidity",
          "required": true,
          "type": "float"
        },
        {
          "name": "co2",
          "required": true,
          "type": "float"
        },
        {
          "name": "soilMoisture",
          "required": true,
          "type": "float"
        },
        {
          "default": "now",
          "index": true,
          "name": "recordedAt",
          "required": true,
          "type": "datetime"
        }
      ],
      "name": "Reading"
    },
    {
      "displayField": "pestType",
      "fields": [
        {
          "name": "id",
          "primary": true,
          "type": "uuid"
        },
        {
          "index": true,
          "name": "deviceId",
          "required": true,
          "type": "uuid"
        },
        {
          "index": true,
          "name": "zoneId",
          "required": true,
          "type": "uuid"
        },
        {
          "name": "snapshot",
          "required": true,
          "type": "image"
        },
        {
          "maxLength": 100,
          "name": "pestType",
          "required": true,
          "type": "string"
        },
        {
          "max": 100,
          "min": 0,
          "name": "confidenceScore",
          "required": true,
          "type": "float"
        },
        {
          "default": "PENDING",
          "name": "status",
          "required": true,
          "type": "enum",
          "values": [
            "PENDING",
            "CONFIRMED",
            "DISMISSED"
          ]
        },
        {
          "default": "now",
          "index": true,
          "name": "detectedAt",
          "required": true,
          "type": "datetime"
        }
      ],
      "name": "PestDetection"
    },
    {
      "displayField": "ruleName",
      "fields": [
        {
          "name": "id",
          "primary": true,
          "type": "uuid"
        },
        {
          "index": true,
          "name": "zoneId",
          "required": true,
          "type": "uuid"
        },
        {
          "index": true,
          "name": "deviceId",
          "nullable": true,
          "required": false,
          "type": "uuid"
        },
        {
          "maxLength": 120,
          "name": "ruleName",
          "required": true,
          "type": "string"
        },
        {
          "maxLength": 500,
          "name": "message",
          "required": true,
          "type": "text"
        },
        {
          "default": "UNACKNOWLEDGED",
          "name": "status",
          "required": true,
          "type": "enum",
          "values": [
            "UNACKNOWLEDGED",
            "ACKNOWLEDGED"
          ]
        },
        {
          "default": "now",
          "index": true,
          "name": "triggeredAt",
          "required": true,
          "type": "datetime"
        },
        {
          "name": "acknowledgedAt",
          "nullable": true,
          "required": false,
          "type": "datetime"
        }
      ],
      "name": "Alert"
    }
  ],
  "operations": [
    {
      "action": "list",
      "auth": "jwt",
      "entity": "Zone",
      "filters": [
        "name"
      ],
      "method": "GET",
      "operationId": "zone.list",
      "pagination": true,
      "path": "/zones",
      "search": [
        "name"
      ],
      "sort": [
        "name",
        "createdAt"
      ],
      "type": "crud"
    },
    {
      "action": "get",
      "auth": "jwt",
      "entity": "Zone",
      "method": "GET",
      "operationId": "zone.get",
      "path": "/zones/{id}",
      "type": "crud"
    },
    {
      "action": "create",
      "entity": "Zone",
      "method": "POST",
      "operationId": "zone.create",
      "path": "/zones",
      "policy": "adminOnly",
      "request": {
        "entity": "Zone",
        "fields": [
          "name",
          "description"
        ]
      },
      "type": "crud"
    },
    {
      "action": "update",
      "entity": "Zone",
      "method": "PATCH",
      "operationId": "zone.update",
      "path": "/zones/{id}",
      "policy": "adminOnly",
      "request": {
        "entity": "Zone",
        "fields": [
          "name",
          "description"
        ]
      },
      "type": "crud"
    },
    {
      "action": "delete",
      "entity": "Zone",
      "method": "DELETE",
      "operationId": "zone.delete",
      "path": "/zones/{id}",
      "policy": "adminOnly",
      "type": "crud"
    },
    {
      "action": "list",
      "auth": "jwt",
      "entity": "Device",
      "filters": [
        "zoneId",
        "status",
        "deviceType",
        "isOnline"
      ],
      "method": "GET",
      "operationId": "device.list",
      "pagination": true,
      "path": "/devices",
      "search": [
        "name"
      ],
      "sort": [
        "status",
        "batteryLevel",
        "lastSeenAt",
        "name"
      ],
      "type": "crud"
    },
    {
      "action": "get",
      "auth": "jwt",
      "entity": "Device",
      "method": "GET",
      "operationId": "device.get",
      "path": "/devices/{id}",
      "type": "crud"
    },
    {
      "action": "create",
      "entity": "Device",
      "method": "POST",
      "operationId": "device.create",
      "path": "/devices",
      "policy": "adminOnly",
      "request": {
        "entity": "Device",
        "fields": [
          "name",
          "zoneId",
          "deviceType",
          "batteryLevel",
          "isOnline"
        ]
      },
      "type": "crud"
    },
    {
      "action": "update",
      "entity": "Device",
      "method": "PATCH",
      "operationId": "device.update",
      "path": "/devices/{id}",
      "policy": "adminOnly",
      "request": {
        "entity": "Device",
        "fields": [
          "name",
          "zoneId",
          "deviceType",
          "batteryLevel",
          "isOnline"
        ]
      },
      "type": "crud"
    },
    {
      "action": "delete",
      "entity": "Device",
      "method": "DELETE",
      "operationId": "device.delete",
      "path": "/devices/{id}",
      "policy": "adminOnly",
      "type": "crud"
    },
    {
      "description": "Operator flags a device that misses heartbeats or reports low battery level, transitioning device status from NORMAL to FLAGGED.",
      "entity": "Device",
      "method": "POST",
      "operationId": "device.flag",
      "path": "/devices/{id}/flag",
      "policy": "operatorOnly",
      "response": {
        "entity": "Device"
      },
      "rules": [
        "deviceFlow"
      ],
      "type": "custom"
    },
    {
      "description": "Admin sends a reboot command to an unresponsive or flagged device, transitioning device status from FLAGGED to REBOOTING.",
      "entity": "Device",
      "method": "POST",
      "operationId": "device.reboot",
      "path": "/devices/{id}/reboot",
      "policy": "adminOnly",
      "response": {
        "entity": "Device"
      },
      "rules": [
        "deviceFlow"
      ],
      "type": "custom"
    },
    {
      "action": "list",
      "auth": "jwt",
      "entity": "Reading",
      "filters": [
        "deviceId",
        "zoneId"
      ],
      "method": "GET",
      "operationId": "reading.list",
      "pagination": true,
      "path": "/readings",
      "ranges": [
        "recordedAt"
      ],
      "sort": [
        "recordedAt"
      ],
      "type": "crud"
    },
    {
      "action": "get",
      "auth": "jwt",
      "entity": "Reading",
      "method": "GET",
      "operationId": "reading.get",
      "path": "/readings/{id}",
      "type": "crud"
    },
    {
      "action": "create",
      "auth": "jwt",
      "entity": "Reading",
      "method": "POST",
      "operationId": "reading.create",
      "path": "/readings",
      "request": {
        "entity": "Reading",
        "fields": [
          "deviceId",
          "zoneId",
          "temperature",
          "humidity",
          "co2",
          "soilMoisture"
        ]
      },
      "type": "crud"
    },
    {
      "action": "list",
      "auth": "jwt",
      "entity": "PestDetection",
      "filters": [
        "status",
        "zoneId",
        "deviceId"
      ],
      "method": "GET",
      "operationId": "pestDetection.list",
      "pagination": true,
      "path": "/pest-detections",
      "search": [
        "pestType"
      ],
      "sort": [
        "detectedAt",
        "confidenceScore"
      ],
      "type": "crud"
    },
    {
      "action": "get",
      "auth": "jwt",
      "entity": "PestDetection",
      "method": "GET",
      "operationId": "pestDetection.get",
      "path": "/pest-detections/{id}",
      "type": "crud"
    },
    {
      "action": "create",
      "auth": "jwt",
      "entity": "PestDetection",
      "method": "POST",
      "operationId": "pestDetection.create",
      "path": "/pest-detections",
      "request": {
        "entity": "PestDetection",
        "fields": [
          "deviceId",
          "zoneId",
          "snapshot",
          "pestType",
          "confidenceScore"
        ]
      },
      "type": "crud"
    },
    {
      "description": "Operator confirms a pending pest detection snapshot, transitioning status from PENDING to CONFIRMED.",
      "entity": "PestDetection",
      "method": "POST",
      "operationId": "pestDetection.confirm",
      "path": "/pest-detections/{id}/confirm",
      "policy": "operatorOnly",
      "response": {
        "entity": "PestDetection"
      },
      "rules": [
        "pestDetectionFlow"
      ],
      "type": "custom"
    },
    {
      "description": "Operator dismisses a false positive pending pest detection, transitioning status from PENDING to DISMISSED.",
      "entity": "PestDetection",
      "method": "POST",
      "operationId": "pestDetection.dismiss",
      "path": "/pest-detections/{id}/dismiss",
      "policy": "operatorOnly",
      "response": {
        "entity": "PestDetection"
      },
      "rules": [
        "pestDetectionFlow"
      ],
      "type": "custom"
    },
    {
      "action": "list",
      "auth": "jwt",
      "entity": "Alert",
      "filters": [
        "status",
        "zoneId",
        "deviceId"
      ],
      "method": "GET",
      "operationId": "alert.list",
      "pagination": true,
      "path": "/alerts",
      "search": [
        "ruleName",
        "message"
      ],
      "sort": [
        "triggeredAt"
      ],
      "type": "crud"
    },
    {
      "action": "get",
      "auth": "jwt",
      "entity": "Alert",
      "method": "GET",
      "operationId": "alert.get",
      "path": "/alerts/{id}",
      "type": "crud"
    },
    {
      "action": "create",
      "auth": "jwt",
      "entity": "Alert",
      "method": "POST",
      "operationId": "alert.create",
      "path": "/alerts",
      "request": {
        "entity": "Alert",
        "fields": [
          "zoneId",
          "deviceId",
          "ruleName",
          "message"
        ]
      },
      "type": "crud"
    },
    {
      "description": "Operator acknowledges an active environmental alert, transitioning status from UNACKNOWLEDGED to ACKNOWLEDGED and stamping acknowledgedAt.",
      "entity": "Alert",
      "method": "POST",
      "operationId": "alert.acknowledge",
      "path": "/alerts/{id}/acknowledge",
      "policy": "operatorOnly",
      "response": {
        "entity": "Alert"
      },
      "rules": [
        "alertFlow"
      ],
      "type": "custom"
    }
  ],
  "policies": [
    {
      "name": "operatorOnly",
      "roles": [
        "operator"
      ],
      "type": "role"
    },
    {
      "name": "adminOnly",
      "roles": [
        "admin"
      ],
      "type": "role"
    }
  ],
  "project": {
    "description": "Commercial greenhouse environmental telemetry, pest monitoring, alert acknowledgment, and device reboot control.",
    "name": "Verdant Greenhouse Monitor",
    "slug": "verdant-greenhouse-monitor"
  },
  "relationships": [
    {
      "foreignKey": "zoneId",
      "from": "Zone",
      "name": "zoneDevices",
      "onDelete": "RESTRICT",
      "to": "Device",
      "type": "one-to-many"
    },
    {
      "foreignKey": "deviceId",
      "from": "Device",
      "name": "deviceReadings",
      "onDelete": "CASCADE",
      "to": "Reading",
      "type": "one-to-many"
    },
    {
      "foreignKey": "zoneId",
      "from": "Zone",
      "name": "zoneReadings",
      "onDelete": "CASCADE",
      "to": "Reading",
      "type": "one-to-many"
    },
    {
      "foreignKey": "deviceId",
      "from": "Device",
      "name": "devicePestDetections",
      "onDelete": "CASCADE",
      "to": "PestDetection",
      "type": "one-to-many"
    },
    {
      "foreignKey": "zoneId",
      "from": "Zone",
      "name": "zonePestDetections",
      "onDelete": "CASCADE",
      "to": "PestDetection",
      "type": "one-to-many"
    },
    {
      "foreignKey": "zoneId",
      "from": "Zone",
      "name": "zoneAlerts",
      "onDelete": "CASCADE",
      "to": "Alert",
      "type": "one-to-many"
    },
    {
      "foreignKey": "deviceId",
      "from": "Device",
      "name": "deviceAlerts",
      "onDelete": "SET NULL",
      "to": "Alert",
      "type": "one-to-many"
    }
  ],
  "rules": [
    {
      "description": "Alerts move from unacknowledged to acknowledged.",
      "entity": "Alert",
      "id": "alertFlow",
      "kind": "transition",
      "params": {
        "field": "status",
        "transitions": {
          "UNACKNOWLEDGED": [
            "ACKNOWLEDGED"
          ]
        }
      }
    },
    {
      "description": "Pest detections move from pending to confirmed or dismissed.",
      "entity": "PestDetection",
      "id": "pestDetectionFlow",
      "kind": "transition",
      "params": {
        "field": "status",
        "transitions": {
          "CONFIRMED": [
            "DISMISSED"
          ],
          "PENDING": [
            "CONFIRMED",
            "DISMISSED"
          ]
        }
      }
    },
    {
      "description": "Devices transition from flagged to rebooting when commanded by admin, and normal to flagged when low battery or offline.",
      "entity": "Device",
      "id": "deviceFlow",
      "kind": "transition",
      "params": {
        "field": "status",
        "transitions": {
          "FLAGGED": [
            "REBOOTING"
          ],
          "NORMAL": [
            "FLAGGED"
          ],
          "REBOOTING": [
            "NORMAL",
            "FLAGGED"
          ]
        }
      }
    }
  ],
