  "specVersion": "1.0",
  "stack": {
    "database": "postgresql",
    "framework": "fastapi",
    "migration": "alembic",
    "orm": "sqlmodel"
  },
  "features": [
    {
      "feature": "telemetry",
      "on": "Reading",
      "options": {
        "device": "Device",
        "deviceField": "deviceId",
        "time": "recordedAt"
      },
      "entities": [],
      "computed": []
    }
  ]
