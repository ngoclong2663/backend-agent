        {
          "name": "id",
          "primary": true,
          "type": "uuid"
        },
        {
          "index": true,
          "name": "deviceId",
          "type": "uuid",
          "required": false
        },
        {
          "index": true,
          "name": "zoneId",
          "type": "uuid",
          "required": false
        },
        {
          "maxLength": 100,
          "name": "pestName",
          "required": true,
          "type": "string"
        },
        {
          "max": 100,
          "min": 0,
          "name": "confidence",
