          "required": true,
          "type": "string"
        },
        {
          "maxLength": 50,
          "name": "metric",
          "required": true,
          "type": "string"
        },
        {
          "name": "thresholdValue",
          "nullable": true,
          "type": "float"
        },
        {
          "name": "currentValue",
          "nullable": true,
          "type": "float"
        },
        {
          "default": "ACTIVE",
          "name": "status",
          "required": true,
          "type": "enum",
          "values": [
            "ACTIVE",
            "ACKNOWLEDGED"
          ]
        },
        {
          "name": "acknowledgedById",
          "nullable": true,
          "type": "uuid"
        },
        {
          "name": "acknowledgedAt",
          "nullable": true,
          "type": "datetime"
        },
        {
          "default": "now",
          "index": true,
          "name": "triggeredAt",
          "required": true,
          "type": "datetime"
        }
      ],
      "name": "Alert"
    }
  ],
