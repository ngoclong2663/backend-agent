      "operationId": "zone.list",
      "pagination": true,
      "path": "/zones",
      "search": [
        "name",
        "code"
      ],
      "sort": [
        "name",
        "code"
      ],
      "type": "crud"
    },
    {
      "action": "get",
      "auth": "jwt",
      "entity": "Zone",
      "method": "GET",
      "operationId": "zone.get",
      "path": "/zones/{id}",
      "type": "crud"
    },
    {
      "action": "create",
      "entity": "Zone",
      "method": "POST",
      "operationId": "zone.create",
      "path": "/zones",
      "policy": "adminsOnly",
      "request": {
        "entity": "Zone",
        "fields": [
          "name",
          "code",
          "description"
        ]
      },
      "type": "crud"
    },
    {
      "action": "update",
      "entity": "Zone",
      "method": "PATCH",
      "operationId": "zone.update",
      "path": "/zones/{id}",
      "policy": "adminsOnly",
      "request": {
        "entity": "Zone",
        "fields": [
          "name",
          "code",
          "description"
        ]
      },
      "type": "crud"
    },
    {
      "action": "delete",
      "entity": "Zone",
      "method": "DELETE",
      "operationId": "zone.delete",
      "path": "/zones/{id}",
      "policy": "adminsOnly",
      "type": "crud"
    },
    {
      "action": "list",
      "auth": "jwt",
      "entity": "Device",
      "filters": [
        "zoneId",
        "deviceType",
        "status",
        "isOnline"
      ],
      "method": "GET",
      "operationId": "device.list",
      "pagination": true,
      "path": "/devices",
      "search": [
        "name"
      ],
      "sort": [
        "name",
        "lastSeenAt",
        "batteryLevel"
      ],
      "type": "crud"
    },
    {
      "action": "get",
      "auth": "jwt",
      "entity": "Device",
      "method": "GET",
      "operationId": "device.get",
      "path": "/devices/{id}",
      "type": "crud"
    },
    {
      "action": "create",
      "entity": "Device",
      "method": "POST",
      "operationId": "device.create",
      "path": "/devices",
      "policy": "adminsOnly",
      "request": {
        "entity": "Device",
        "fields": [
          "name",
          "deviceType",
          "zoneId",
          "batteryLevel",
          "isOnline"
        ]
      },
      "type": "crud"
    },
    {
      "action": "update",
      "entity": "Device",
      "method": "PATCH",
      "operationId": "device.update",
      "path": "/devices/{id}",
      "policy": "adminsOnly",
      "request": {
        "entity": "Device",
        "fields": [
          "name",
          "deviceType",
          "zoneId",
          "batteryLevel",
          "isOnline"
        ]
      },
      "type": "crud"
    },
    {
      "action": "delete",
      "entity": "Device",
      "method": "DELETE",
      "operationId": "device.delete",
      "path": "/devices/{id}",
      "policy": "adminsOnly",
      "type": "crud"
    },
    {
      "description": "Admin sends remote reboot command to an unhealthy device. Sets device status to REBOOTING and initiates device reboot sequence.",
      "entity": "Device",
      "method": "POST",
      "operationId": "device.reboot",
      "path": "/devices/{id}/reboot",
      "policy": "adminsOnly",
      "rules": [
        "deviceFlow"
      ],
      "type": "custom",
      "response": {
        "entity": "Device"
      }
    },
    {
      "action": "list",
      "auth": "jwt",
      "entity": "Reading",
      "filters": [
        "deviceId",
        "zoneId",
        "metric"
      ],
      "method": "GET",
      "operationId": "reading.list",
      "pagination": true,
      "path": "/readings",
      "ranges": [
        "recordedAt"
      ],
      "sort": [
        "recordedAt"
      ],
      "type": "crud"
    },
    {
      "action": "get",
      "auth": "jwt",
      "entity": "Reading",
      "method": "GET",
      "operationId": "reading.get",
      "path": "/readings/{id}",
      "type": "crud"
    },
    {
      "action": "create",
      "auth": "jwt",
      "entity": "Reading",
      "method": "POST",
      "operationId": "reading.create",
      "path": "/readings",
      "request": {
        "entity": "Reading",
        "fields": [
          "deviceId",
          "zoneId",
          "metric",
          "value",
          "unit",
          "recordedAt"
        ]
      },
      "type": "crud"
    },
    {
      "action": "list",
      "auth": "jwt",
      "entity": "Detection",
      "filters": [
        "zoneId",
        "deviceId",
        "status",
        "pestName"
      ],
      "method": "GET",
      "operationId": "detection.list",
      "pagination": true,
      "path": "/detections",
      "search": [
        "pestName"
      ],
      "sort": [
        "detectedAt",
        "confidence"
      ],
      "type": "crud"
    },
    {
      "action": "get",
      "auth": "jwt",
      "entity": "Detection",
      "method": "GET",
      "operationId": "detection.get",
      "path": "/detections/{id}",
      "type": "crud"
    },
    {
      "action": "create",
      "auth": "jwt",
      "entity": "Detection",
      "method": "POST",
      "operationId": "detection.create",
      "path": "/detections",
      "request": {
        "entity": "Detection",
        "fields": [
          "deviceId",
          "zoneId",
          "pestName",
          "confidence",
          "snapshot",
          "detectedAt"
        ]
      },
      "type": "crud"
    },
    {
      "description": "Operator confirms a pending pest detection for greenhouse treatment. Changes status from PENDING to CONFIRMED and records reviewer information.",
      "entity": "Detection",
      "method": "POST",
      "operationId": "detection.confirm",
      "path": "/detections/{id}/confirm",
      "policy": "operatorsOnly",
      "rules": [
        "detectionFlow"
      ],
      "type": "custom",
      "response": {
        "entity": "Detection"
      }
    },
    {
      "description": "Operator dismisses a pending pest detection as a false alarm. Changes status from PENDING to DISMISSED and records reviewer information.",
      "entity": "Detection",
      "method": "POST",
      "operationId": "detection.dismiss",
      "path": "/detections/{id}/dismiss",
      "policy": "operatorsOnly",
      "rules": [
        "detectionFlow"
      ],
      "type": "custom",
      "response": {
        "entity": "Detection"
      }
    },
    {
      "action": "list",
      "auth": "jwt",
      "entity": "Alert",
      "filters": [
        "zoneId",
        "deviceId",
        "status",
        "metric"
      ],
      "method": "GET",
      "operationId": "alert.list",
      "pagination": true,
      "path": "/alerts",
      "search": [
        "message"
      ],
      "sort": [
        "triggeredAt"
      ],
      "type": "crud"
    },
    {
      "action": "get",
      "auth": "jwt",
      "entity": "Alert",
      "method": "GET",
      "operationId": "alert.get",
      "path": "/alerts/{id}",
      "type": "crud"
    },
    {
      "action": "create",
      "auth": "jwt",
      "entity": "Alert",
      "method": "POST",
      "operationId": "alert.create",
      "path": "/alerts",
      "request": {
        "entity": "Alert",
        "fields": [
          "zoneId",
          "deviceId",
          "message",
          "metric",
          "thresholdValue",
          "currentValue",
          "triggeredAt"
        ]
      },
      "type": "crud"
    },
    {
      "description": "Operator acknowledges an active alert. Changes status from ACTIVE to ACKNOWLEDGED, recording the operator user id and timestamp.",
      "entity": "Alert",
      "method": "POST",
      "operationId": "alert.acknowledge",
      "path": "/alerts/{id}/acknowledge",
      "policy": "operatorsOnly",
      "rules": [
        "alertFlow",
        "acknowledgedIsFinal"
      ],
      "type": "custom",
      "response": {
        "entity": "Alert"
      }
    },
    {
      "operationId": "alert.countWhereStatusActive",
      "type": "aggregate",
      "entity": "Alert",
      "method": "GET",
      "path": "/alerts/aggregate/count-where-status-active",
      "summary": "Active Alerts",
      "aggregate": {
        "fn": "count",
        "filters": {
          "status": "ACTIVE"
        }
      }
    },
    {
      "operationId": "detection.countWhereStatusPending",
      "type": "aggregate",
      "entity": "Detection",
      "method": "GET",
      "path": "/detections/aggregate/count-where-status-pending",
      "summary": "Pending Detections",
      "aggregate": {
        "fn": "count",
        "filters": {
          "status": "PENDING"
        }
      }
    },
    {
      "operationId": "device.countWhereStatusUnhealthy",
      "type": "aggregate",
      "entity": "Device",
      "method": "GET",
      "path": "/devices/aggregate/count-where-status-unhealthy",
      "summary": "Unhealthy Devices",
      "aggregate": {
        "fn": "count",
        "filters": {
          "status": "UNHEALTHY"
        }
      }
    },
    {
      "operationId": "device.countByStatus",
      "type": "aggregate",
      "entity": "Device",
      "method": "GET",
      "path": "/devices/aggregate/count-by-status",
      "summary": "Devices by Status",
      "aggregate": {
        "fn": "count",
        "groupBy": "status"
      }
    },
    {
      "operationId": "detection.countByPestName",
      "type": "aggregate",
      "entity": "Detection",
      "method": "GET",
      "path": "/detections/aggregate/count-by-pest-name",
      "summary": "Detections by Pest",
      "aggregate": {
        "fn": "count",
        "groupBy": "pestName"
      }
    }
  ],
  "policies": [
    {
      "name": "operatorsOnly",
      "roles": [
        "operator"
      ],
      "type": "role"
    },
    {
      "name": "adminsOnly",
      "roles": [
        "admin"
      ],
      "type": "role"
    }
  ],
  "project": {
    "description": "Monitoring app for a commercial greenhouse: sensor telemetry, pest detections, alerts, and remote device management.",
    "name": "Verdant Greenhouse Monitor",
    "slug": "verdant-greenhouse-monitor"
  },
  "relationships": [
    {
      "foreignKey": "zoneId",
      "from": "Zone",
      "name": "zoneDevices",
      "onDelete": "RESTRICT",
      "to": "Device",
      "type": "one-to-many"
    },
    {
      "foreignKey": "zoneId",
      "from": "Zone",
      "name": "zoneReadings",
      "onDelete": "CASCADE",
      "to": "Reading",
      "type": "one-to-many"
    },
    {
      "foreignKey": "deviceId",
      "from": "Device",
      "name": "deviceReadings",
      "onDelete": "CASCADE",
      "to": "Reading",
      "type": "one-to-many"
    },
    {
      "foreignKey": "zoneId",
      "from": "Zone",
      "name": "zoneDetections",
      "onDelete": "CASCADE",
      "to": "Detection",
      "type": "one-to-many"
    },
    {
      "foreignKey": "deviceId",
      "from": "Device",
      "name": "deviceDetections",
      "onDelete": "CASCADE",
      "to": "Detection",
      "type": "one-to-many"
    },
    {
      "foreignKey": "zoneId",
      "from": "Zone",
      "name": "zoneAlerts",
      "onDelete": "CASCADE",
      "to": "Alert",
      "type": "one-to-many"
    },
    {
      "foreignKey": "deviceId",
      "from": "Device",
      "name": "deviceAlerts",
      "onDelete": "SET NULL",
      "to": "Alert",
      "type": "one-to-many"
    }
  ],
  "rules": [
    {
      "description": "Alert status moves from ACTIVE to ACKNOWLEDGED.",
      "entity": "Alert",
      "id": "alertFlow",
      "kind": "transition",
      "params": {
        "field": "status",
        "transitions": {
          "ACTIVE": [
            "ACKNOWLEDGED"
          ]
        }
      }
    },
    {
      "description": "Acknowledged alerts cannot be modified further.",
      "entity": "Alert",
      "id": "acknowledgedIsFinal",
      "kind": "immutableAfter",
      "params": {
        "field": "status",
        "states": [
          "ACKNOWLEDGED"
        ]
      }
    },
    {
      "description": "Detection status moves from PENDING to CONFIRMED or DISMISSED.",
      "entity": "Detection",
      "id": "detectionFlow",
      "kind": "transition",
      "params": {
        "field": "status",
        "transitions": {
          "PENDING": [
            "CONFIRMED",
            "DISMISSED"
          ]
        }
      }
    },
    {
      "description": "Unhealthy device moves to REBOOTING upon reboot command.",
      "entity": "Device",
      "id": "deviceFlow",
      "kind": "transition",
      "params": {
        "field": "status",
        "transitions": {
          "HEALTHY": [
            "UNHEALTHY"
          ],
          "UNHEALTHY": [
            "REBOOTING"
          ]
        }
      }
    }
  ],
