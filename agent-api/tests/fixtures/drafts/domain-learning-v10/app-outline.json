  "workflows": {
    "version": "8268a4355517",
    "tours": [
      {
        "id": "course_learning_and_completion",
        "name": "Learn and Complete Course",
        "outcome": "Learner finishes all lessons and completes the course.",
        "roles": [
          "learner"
        ],
        "steps": [
          {
            "id": "step_browse_catalogue",
            "role": "learner",
            "actor": "Learner",
            "title": "Browse catalogue by category. Rule: Only published courses are visible",
            "operationId": "course.list",
            "page": "home",
            "route": "/",
            "target": {
              "section": "resume",
              "action": null
            },
            "kind": "look",
            "record": "course"
          },
          {
            "id": "step_enroll_course",
            "role": "learner",
            "actor": "Learner",
            "title": "Enroll in course (the enrollment becomes active). Rule: Learner must not already be enrolled",
            "operationId": "courseEnrollment.create",
            "statusAfter": "active",
            "page": "courses-id",
            "route": "/courses/[id]",
            "target": {
              "section": "courses-detail",
              "action": "enroll"
            },
            "kind": "do",
            "record": "enrollment"
          },
          {
            "id": "step_view_lesson",
            "role": "learner",
            "actor": "Learner",
            "title": "Resume and view next lesson (the lesson becomes in_progress). Rule: Must follow lesson order",
            "operationId": "lesson.start",
            "statusAfter": "in_progress",
            "page": "lessons-id",
            "route": "/lessons/[id]",
            "target": {
              "section": "lessons-detail",
              "action": "start"
            },
            "kind": "do",
            "record": "lesson"
          },
          {
            "id": "step_mark_lesson_complete",
            "role": "learner",
            "actor": "Learner",
            "title": "Mark lesson complete (the lesson_progress becomes completed). Rule: All previous lessons must be completed",
            "operationId": "lessonCompletion.create",
            "statusAfter": "completed",
            "page": "lessons-id",
            "route": "/lessons/[id]",
            "target": {
              "section": "lessons-detail",
              "action": "complete"
            },
            "kind": "do",
            "record": "lesson_progress"
          },
          {
            "id": "step_complete_course",
            "role": "learner",
            "actor": "Learner",
            "title": "Complete course (the enrollment becomes completed). Rule: All lessons in the course must be marked complete",
            "operationId": null,
            "statusAfter": "completed",
            "automatic": true,
            "page": "courses-id",
            "route": "/courses/[id]",
            "kind": "note",
            "record": "enrollment"
          }
        ]
      },
      {
        "id": "course_publishing",
        "name": "Publish Course",
        "outcome": "A structured course is published and available for learner enrollment.",
        "roles": [
          "admin",
          "instructor"
        ],
        "steps": [
          {
            "id": "step_create_category",
            "role": "admin",
            "actor": "Administrator",
            "title": "Create category (the category becomes active). Rule: Category name must be unique",
            "operationId": "category.create",
            "statusAfter": "active",
            "page": "admins-categories-new",
            "route": "/admins/categories/new",
            "target": {
              "section": "category-create-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "category"
          },
          {
            "id": "step_create_course",
            "role": "instructor",
            "actor": "Instructor",
            "title": "Create course draft (the course becomes draft). Rule: Must select an existing category",
            "operationId": "course.create",
            "statusAfter": "draft",
            "page": "instructors-categories-id-courses-new",
            "route": "/instructors/categories/[id]/courses/new",
            "target": {
              "section": "course-create-in-category-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "course"
          },
          {
            "id": "step_add_lessons",
            "role": "instructor",
            "actor": "Instructor",
            "title": "Add ordered lessons and quizzes (the lesson becomes draft). Rule: Lessons must have video or written content and sequential order",
            "operationId": "lesson.create",
            "statusAfter": "draft",
            "page": "instructors-courses-id-lessons-new",
            "route": "/instructors/courses/[id]/lessons/new",
            "target": {
              "section": "lesson-create-in-course-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "lesson"
          },
          {
            "id": "step_publish_course",
            "role": "instructor",
            "actor": "Instructor",
            "title": "Publish course (the course becomes published). Rule: Course must contain at least one lesson",
            "operationId": "course.publish",
            "statusAfter": "published",
            "page": "instructors-courses-id",
            "route": "/instructors/courses/[id]",
            "target": {
              "section": "courses-detail",
              "action": "publish"
            },
            "kind": "do",
            "record": "course",
            "needs": {
              "step": "step_create_course",
              "role": "instructor",
              "status": "draft"
            }
          }
        ]
      },
      {
        "id": "course_reviewing",
        "name": "Review Course",
        "outcome": "Learner review and rating are published for the completed course.",
        "roles": [
          "learner"
        ],
        "steps": [
          {
            "id": "step_submit_review",
            "role": "learner",
            "actor": "Learner",
            "title": "Submit course rating and review (the review becomes published). Rule: Learner must have completed the course and can only review once",
            "operationId": "review.create",
            "statusAfter": "published",
            "page": "courses-id-reviews-new",
            "route": "/courses/[id]/reviews/new",
            "target": {
              "section": "review-create-in-course-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "review"
          }
        ]
      }
    ]
  }
}
