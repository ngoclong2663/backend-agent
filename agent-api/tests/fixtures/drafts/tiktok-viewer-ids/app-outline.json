  "workflows": {
    "version": "e6f974b02f1a",
    "tours": [
      {
        "id": "publish_video",
        "name": "Publish Short Video",
        "outcome": "A short video is live and available in the feed for viewers",
        "roles": [
          "Creator"
        ],
        "steps": [
          {
            "id": "upload_file",
            "role": "Creator",
            "actor": "Creator",
            "title": "Select and upload a video file (the video becomes draft). Rule: Video must meet supported media specs",
            "operationId": "video.create",
            "statusAfter": "draft",
            "page": "videos-new",
            "route": "/videos/new",
            "target": {
              "section": "video-create-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "video"
          },
          {
            "id": "submit_video",
            "role": "Creator",
            "actor": "Creator",
            "title": "Add caption and publish the video (the video becomes published). Rule: Caption must not exceed maximum length",
            "operationId": "video.publish",
            "statusAfter": "published",
            "page": "videos-id",
            "route": "/videos/[id]",
            "target": {
              "section": "videos-detail",
              "action": "publish"
            },
            "kind": "do",
            "record": "video",
            "needs": {
              "step": "upload_file",
              "role": "Creator",
              "status": "draft"
            }
          }
        ]
      },
      {
        "id": "watch_and_engage",
        "name": "Watch and Engage with Feed",
        "outcome": "Viewer watches videos and interacts with creators",
        "roles": [
          "Viewer"
        ],
        "steps": [
          {
            "id": "view_feed",
            "role": "Viewer",
            "actor": "Viewer",
            "title": "Browse and watch videos in the vertical feed. Rule: Display only published videos",
            "operationId": "video.list",
            "page": "viewers-videos",
            "route": "/viewers/videos",
            "target": {
              "section": "videos-list",
              "action": null
            },
            "kind": "look",
            "record": "video"
          },
          {
            "id": "like_video",
            "role": "Viewer",
            "actor": "Viewer",
            "title": "Like the current video (the interaction becomes liked). Rule: A user can like a video once",
            "operationId": "interaction.like",
            "statusAfter": "liked",
            "page": "viewers-videos-id",
            "route": "/viewers/videos/[id]",
            "target": {
              "section": "videos-detail",
              "action": "add-interactions"
            },
            "kind": "do",
            "record": "interaction"
          },
          {
            "id": "post_comment",
            "role": "Viewer",
            "actor": "Viewer",
            "title": "Post a comment on the video (the interaction becomes commented). Rule: Comment text cannot be empty",
            "operationId": "comment.create",
            "statusAfter": "commented",
            "page": "viewers-videos-id-comments-new",
            "route": "/viewers/videos/[id]/comments/new",
            "target": {
              "section": "comment-create-in-video-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "interaction",
            "needs": {
              "step": "like_video",
              "role": "Viewer",
              "status": "liked"
            }
          }
        ]
      }
    ]
  }
}
