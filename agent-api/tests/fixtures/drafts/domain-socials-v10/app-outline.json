  "workflows": {
    "version": "a65122ec5d57",
    "tours": [
      {
        "id": "post_and_discover_clip",
        "name": "Post and Discover Clip",
        "outcome": "A short clip is published and discoverable by community members in the feed",
        "roles": [
          "Member"
        ],
        "steps": [
          {
            "id": "upload_clip",
            "role": "Member",
            "actor": "Member",
            "title": "Upload video with caption (the clip becomes published). Rule: Clip must be a short video with a caption",
            "operationId": "clip.create",
            "statusAfter": "published",
            "page": "clips-new",
            "route": "/clips/new",
            "target": {
              "section": "clip-create-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "clip"
          },
          {
            "id": "view_feed",
            "role": "Member",
            "actor": "Member",
            "title": "Browse community feed and view clip (the clip becomes published). Rule: Only visible non-hidden clips are shown",
            "operationId": "clip.get",
            "statusAfter": "published",
            "page": "clips-id",
            "route": "/clips/[id]",
            "target": {
              "section": "clips-detail",
              "action": null
            },
            "kind": "look",
            "record": "clip"
          }
        ]
      },
      {
        "id": "engage_with_community",
        "name": "Engage with Community",
        "outcome": "Social interactions and connections are established, notifying the creator",
        "roles": [
          "Member"
        ],
        "steps": [
          {
            "id": "interact_clip",
            "role": "Member",
            "actor": "Member",
            "title": "Like clip or comment on clip (the interaction becomes recorded). Rule: Interactions require signed-in member account",
            "operationId": "clipReaction.create",
            "statusAfter": "recorded",
            "page": "clips-id",
            "route": "/clips/[id]",
            "target": {
              "section": "clips-detail",
              "action": "react-like"
            },
            "kind": "do",
            "record": "interaction"
          },
          {
            "id": "follow_creator",
            "role": "Member",
            "actor": "Member",
            "title": "Follow clip creator (the follow becomes active). Rule: Member cannot follow themselves",
            "operationId": "follow.create",
            "statusAfter": "active",
            "page": "follows-new",
            "route": "/follows/new",
            "target": {
              "section": "follow-create-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "follow"
          },
          {
            "id": "receive_notification",
            "role": "Member",
            "actor": "Member",
            "title": "Receive interaction notification (the notification becomes delivered). Rule: Notify recipient on likes, replies, and follows",
            "operationId": null,
            "statusAfter": "delivered",
            "automatic": true,
            "page": "notifications",
            "route": "/notifications",
            "kind": "note",
            "record": "notification"
          }
        ]
      },
      {
        "id": "moderate_content",
        "name": "Moderate Reported Content",
        "outcome": "Inappropriate content is hidden to keep the community safe",
        "roles": [
          "Member",
          "Moderator"
        ],
        "steps": [
          {
            "id": "submit_report",
            "role": "Member",
            "actor": "Member",
            "title": "Submit report on clip or comment (the report becomes pending). Rule: Anyone can report suspicious or abusive content",
            "operationId": "report.create",
            "statusAfter": "pending",
            "page": "reports-new",
            "route": "/reports/new",
            "target": {
              "section": "report-create-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "report"
          },
          {
            "id": "review_report",
            "role": "Moderator",
            "actor": "Moderator",
            "title": "Review reported content (the report becomes reviewed). Rule: Moderator evaluates against community guidelines",
            "operationId": "report.review",
            "statusAfter": "reviewed",
            "page": "moderators-reports-id",
            "route": "/moderators/reports/[id]",
            "target": {
              "section": "reports-detail",
              "action": "review"
            },
            "kind": "do",
            "record": "report",
            "needs": {
              "step": "submit_report",
              "role": "Member",
              "status": "pending"
            }
          },
          {
            "id": "hide_content",
            "role": "Moderator",
            "actor": "Moderator",
            "title": "Hide rule-breaking content (the clip becomes hidden). Rule: Rule-breaking clips and comments must be hidden from feeds and profiles",
            "operationId": "clip.hide",
            "statusAfter": "hidden",
            "page": "moderators-clips-id",
            "route": "/moderators/clips/[id]",
            "target": {
              "section": "clips-detail",
              "action": "hide"
            },
            "kind": "do",
            "record": "clip"
          }
        ]
      }
    ]
  }
}
