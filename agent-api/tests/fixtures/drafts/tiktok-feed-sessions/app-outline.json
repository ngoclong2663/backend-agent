  "workflows": {
    "version": "51ba5c810360",
    "tours": [
      {
        "id": "watch_feed",
        "name": "Watch Video Feed",
        "outcome": "Viewer continuously discovers and watches short-form video content",
        "roles": [
          "Viewer"
        ],
        "steps": [
          {
            "id": "wf1_step1",
            "role": "Viewer",
            "actor": "Viewer",
            "title": "Open video feed (the feed becomes active). Rule: Display published videos in a vertical feed",
            "operationId": "feedSession.create",
            "statusAfter": "active",
            "page": "feed-sessions",
            "route": "/feed-sessions",
            "skip": "no screen performs this step",
            "kind": "note",
            "record": "feed"
          },
          {
            "id": "wf1_step2",
            "role": "Viewer",
            "actor": "Viewer",
            "title": "Play video (the video becomes viewed). Rule: Video must be published and playable",
            "operationId": "video.play",
            "statusAfter": "viewed",
            "page": "videos-id",
            "route": "/videos/[id]",
            "target": {
              "section": "videos-detail",
              "action": "play"
            },
            "kind": "do",
            "record": "video"
          }
        ]
      },
      {
        "id": "publish_video",
        "name": "Publish Short Video",
        "outcome": "Video is published and available for viewers in the feed",
        "roles": [
          "Creator"
        ],
        "steps": [
          {
            "id": "wf2_step1",
            "role": "Creator",
            "actor": "Creator",
            "title": "Select video file and caption (the video becomes draft). Rule: Video file must be provided",
            "operationId": "video.create",
            "statusAfter": "draft",
            "page": "creator-area-videos-new",
            "route": "/creator-area/videos/new",
            "target": {
              "section": "video-create-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "video"
          },
          {
            "id": "wf2_step2",
            "role": "Creator",
            "actor": "Creator",
            "title": "Submit and upload video (the video becomes published). Rule: Upload completes successfully",
            "operationId": "video.publish",
            "statusAfter": "published",
            "page": "creator-area-videos-id",
            "route": "/creator-area/videos/[id]",
            "target": {
              "section": "videos-detail",
              "action": "publish"
            },
            "kind": "do",
            "record": "video",
            "needs": {
              "step": "wf2_step1",
              "role": "Creator",
              "status": "draft"
            }
          }
        ]
      },
      {
        "id": "engage_with_video",
        "name": "Engage with Video",
        "outcome": "Like or comment is attached to the video",
        "roles": [
          "Viewer"
        ],
        "steps": [
          {
            "id": "wf3_step1",
            "role": "Viewer",
            "actor": "Viewer",
            "title": "Submit like on video (the interaction becomes liked). Rule: A user can like a video once",
            "operationId": "interaction.create",
            "statusAfter": "liked",
            "page": "videos-id-interactions-new",
            "route": "/videos/[id]/interactions/new",
            "target": {
              "section": "interaction-create-in-video-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "interaction"
          },
          {
            "id": "wf3_step2",
            "role": "Viewer",
            "actor": "Viewer",
            "title": "Submit comment on video (the comment becomes posted). Rule: Comment text must not be empty",
            "operationId": "comment.create",
            "statusAfter": "posted",
            "page": "videos-id-comments-new",
            "route": "/videos/[id]/comments/new",
            "target": {
              "section": "comment-create-in-video-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "comment"
          }
        ]
      }
    ]
  }
}
