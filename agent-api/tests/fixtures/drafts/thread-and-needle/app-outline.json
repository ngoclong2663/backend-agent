  "workflows": {
    "version": "b772e58f6f44",
    "tours": [
      {
        "id": "purchase_order",
        "name": "Purchase Products",
        "outcome": "Order is placed and paid, and product inventory is updated",
        "roles": [
          "Shopper"
        ],
        "steps": [
          {
            "id": "browse_products",
            "role": "Shopper",
            "actor": "Shopper",
            "title": "Browse yarn and fabric products. Rule: Displays photo, colour, weight or width, price, and available stock",
            "operationId": "product.get",
            "page": "products-id",
            "route": "/products/[id]",
            "target": {
              "section": "products-detail",
              "action": null
            },
            "kind": "look",
            "record": "product"
          },
          {
            "id": "add_to_cart",
            "role": "Shopper",
            "actor": "Shopper",
            "title": "Add items with quantity to shopping cart (the cart becomes open). Rule: Quantity must not exceed available stock",
            "operationId": "cartItem.create",
            "statusAfter": "open",
            "page": "products-id-cart-items-new",
            "route": "/products/[id]/cart-items/new",
            "target": {
              "section": "cart-item-create-in-product-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "cart"
          },
          {
            "id": "adjust_cart",
            "role": "Shopper",
            "actor": "Shopper",
            "title": "Adjust item quantities in cart (the cart becomes open). Rule: Quantity must be greater than zero and within stock limit",
            "operationId": "cartItem.update",
            "statusAfter": "open",
            "page": "cart-items-id-edit",
            "route": "/cart-items/[id]/edit",
            "target": {
              "section": "cart-items-edit-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "cart",
            "needs": {
              "step": "add_to_cart",
              "role": "Shopper",
              "status": "open"
            }
          },
          {
            "id": "checkout_and_pay",
            "role": "Shopper",
            "actor": "Shopper",
            "title": "Check out and pay for cart items (the order becomes paid). Rule: Payment confirms order and decrements product stock",
            "operationId": "order.checkout",
            "statusAfter": "paid",
            "page": "orders",
            "route": "/orders",
            "target": {
              "section": "orders-actions",
              "action": "checkout"
            },
            "kind": "do",
            "record": "order"
          }
        ]
      },
      {
        "id": "fulfill_order",
        "name": "Fulfill Customer Order",
        "outcome": "Order is fulfilled and marked delivered to the shopper",
        "roles": [
          "Shop Owner"
        ],
        "steps": [
          {
            "id": "review_paid_order",
            "role": "Shop Owner",
            "actor": "Shop Owner",
            "title": "Review paid customer order (the order becomes paid). Rule: Order must be in paid status",
            "operationId": "order.get",
            "statusAfter": "paid",
            "page": "owner-area-orders-id",
            "route": "/owner-area/orders/[id]",
            "target": {
              "section": "orders-detail",
              "action": null
            },
            "kind": "look",
            "record": "order"
          },
          {
            "id": "mark_shipped",
            "role": "Shop Owner",
            "actor": "Shop Owner",
            "title": "Mark order as shipped (the order becomes shipped). Rule: Order must be packaged for shipment",
            "operationId": "order.ship",
            "statusAfter": "shipped",
            "page": "owner-area-orders-id",
            "route": "/owner-area/orders/[id]",
            "target": {
              "section": "orders-detail",
              "action": "ship"
            },
            "kind": "do",
            "record": "order"
          },
          {
            "id": "mark_delivered",
            "role": "Shop Owner",
            "actor": "Shop Owner",
            "title": "Mark order as delivered (the order becomes delivered). Rule: Order package has been delivered to customer",
            "operationId": "order.deliver",
            "statusAfter": "delivered",
            "page": "owner-area-orders-id",
            "route": "/owner-area/orders/[id]",
            "target": {
              "section": "orders-detail",
              "action": "deliver"
            },
            "kind": "do",
            "record": "order",
            "needs": {
              "step": "mark_shipped",
              "role": "Shop Owner",
              "status": "shipped"
            }
          }
        ]
      }
    ]
  }
}
