  "workflows": {
    "version": "9f95355a2363",
    "tours": [
      {
        "id": "monitor_climate_and_acknowledge_alerts",
        "name": "Monitor Climate and Acknowledge Alerts",
        "outcome": "Zone environmental excursions are identified and acknowledged by an operator",
        "roles": [
          "operator"
        ],
        "steps": [
          {
            "id": "inspect_telemetry",
            "role": "operator",
            "actor": "Greenhouse Operator",
            "title": "Inspect zone dashboard and 24-hour sensor trends (the reading becomes reviewed). Rule: Readings must display latest values and 24-hour historical charts",
            "operationId": "sensorReading.review",
            "statusAfter": "reviewed",
            "page": "sensor-readings-id",
            "route": "/sensor-readings/[id]",
            "target": {
              "section": "sensor-readings-detail",
              "action": "review"
            },
            "kind": "do",
            "record": "reading"
          },
          {
            "id": "generate_alert",
            "role": "operator",
            "actor": "Greenhouse Operator",
            "title": "Trigger alert on rule violation (the alert becomes active). Rule: Alert triggers when conditions exceed configured threshold duration",
            "operationId": "alert.trigger",
            "statusAfter": "active",
            "page": "alerts",
            "route": "/alerts",
            "target": {
              "section": "alerts-actions",
              "action": "trigger"
            },
            "kind": "do",
            "record": "alert"
          },
          {
            "id": "acknowledge_alert",
            "role": "operator",
            "actor": "Greenhouse Operator",
            "title": "Acknowledge active alert (the alert becomes acknowledged). Rule: Only active alerts can be acknowledged",
            "operationId": "alert.acknowledge",
            "statusAfter": "acknowledged",
            "page": "alerts-id",
            "route": "/alerts/[id]",
            "target": {
              "section": "alerts-detail",
              "action": "acknowledge"
            },
            "kind": "do",
            "record": "alert",
            "needs": {
              "step": "generate_alert",
              "role": "operator",
              "status": "active"
            }
          }
        ]
      },
      {
        "id": "review_pest_detections",
        "name": "Review Pest Detections",
        "outcome": "Camera pest detections are validated to guide greenhouse pest interventions",
        "roles": [
          "operator"
        ],
        "steps": [
          {
            "id": "review_detection",
            "role": "operator",
            "actor": "Greenhouse Operator",
            "title": "Inspect pest detection snapshot and confidence score (the detection becomes reviewed). Rule: Detections must include snapshot image and model confidence score",
            "operationId": "pestDetection.review",
            "statusAfter": "reviewed",
            "page": "pest-detections-id",
            "route": "/pest-detections/[id]",
            "target": {
              "section": "pest-detections-detail",
              "action": "review"
            },
            "kind": "do",
            "record": "detection"
          },
          {
            "id": "confirm_detection",
            "role": "operator",
            "actor": "Greenhouse Operator",
            "title": "Confirm pest detection (the detection becomes confirmed). Rule: Confirmed detections validate pest presence on bench",
            "operationId": "pestDetection.confirm",
            "statusAfter": "confirmed",
            "page": "pest-detections-id",
            "route": "/pest-detections/[id]",
            "target": {
              "section": "pest-detections-detail",
              "action": "confirm"
            },
            "kind": "do",
            "record": "detection",
            "needs": {
              "step": "review_detection",
              "role": "operator",
              "status": "reviewed"
            }
          }
        ]
      },
      {
        "id": "manage_device_health",
        "name": "Manage Device Health",
        "outcome": "Unhealthy or offline monitoring devices are restored to maintain telemetry",
        "roles": [
          "admin",
          "operator"
        ],
        "steps": [
          {
            "id": "inspect_devices",
            "role": "operator",
            "actor": "Greenhouse Operator",
            "title": "Review device connectivity and battery status (the device becomes flagged). Rule: Flags devices that are offline or have low battery",
            "operationId": "device.flag",
            "statusAfter": "flagged",
            "page": "devices-id",
            "route": "/devices/[id]",
            "target": {
              "section": "devices-detail",
              "action": "flag"
            },
            "kind": "do",
            "record": "device"
          },
          {
            "id": "reboot_device",
            "role": "admin",
            "actor": "Greenhouse Admin",
            "title": "Send reboot command to device (the device becomes rebooting). Rule: Only admins can issue remote device reboot commands",
            "operationId": "device.reboot",
            "statusAfter": "rebooting",
            "page": "admins-devices-id",
            "route": "/admins/devices/[id]",
            "target": {
              "section": "devices-detail",
              "action": "reboot"
            },
            "kind": "do",
            "record": "device",
            "needs": {
              "step": "inspect_devices",
              "role": "operator",
              "status": "flagged"
            }
          }
        ]
      }
    ]
  }
}
