  "workflows": {
    "version": "22b83934143f",
    "tours": [
      {
        "id": "post_clip",
        "name": "Post a clip",
        "outcome": "A short video clip is published to the feed and appears on the creator profile",
        "roles": [
          "Member"
        ],
        "steps": [
          {
            "id": "post_clip_1",
            "role": "Member",
            "actor": "Member",
            "title": "Upload clip with caption (the clip becomes published). Rule: Clip must include valid video content and a caption",
            "operationId": "clip.create",
            "statusAfter": "published",
            "page": "clips-new",
            "route": "/clips/new",
            "target": {
              "section": "clip-create-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "clip"
          },
          {
            "id": "post_clip_2",
            "role": "Member",
            "actor": "Member",
            "title": "Display clip on creator profile (the profile becomes updated)",
            "operationId": null,
            "statusAfter": "updated",
            "automatic": true,
            "kind": "note",
            "record": "profile"
          }
        ]
      },
      {
        "id": "engage_with_content",
        "name": "Engage with content",
        "outcome": "Feedback is recorded on the clip and the clip author is notified",
        "roles": [
          "Member"
        ],
        "steps": [
          {
            "id": "engage_clip_1",
            "role": "Member",
            "actor": "Member",
            "title": "Like or comment on clip (the clip becomes engaged). Rule: Member can like once per clip",
            "operationId": "like.create",
            "statusAfter": "engaged",
            "page": "clips-id",
            "route": "/clips/[id]",
            "target": {
              "section": "clips-detail",
              "action": "add-likes"
            },
            "kind": "do",
            "record": "clip"
          },
          {
            "id": "engage_clip_2",
            "role": "Member",
            "actor": "Member",
            "title": "Notify clip author (the notification becomes sent)",
            "operationId": null,
            "statusAfter": "sent",
            "automatic": true,
            "kind": "note",
            "record": "notification"
          }
        ]
      },
      {
        "id": "follow_creator",
        "name": "Follow a creator",
        "outcome": "The member follows the creator and follow counts are updated",
        "roles": [
          "Member"
        ],
        "steps": [
          {
            "id": "follow_creator_1",
            "role": "Member",
            "actor": "Member",
            "title": "Follow creator (the profile becomes following). Rule: Cannot follow oneself",
            "operationId": "follow.create",
            "statusAfter": "following",
            "page": "follows-new",
            "route": "/follows/new",
            "target": {
              "section": "follow-create-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "profile"
          },
          {
            "id": "follow_creator_2",
            "role": "Member",
            "actor": "Member",
            "title": "Notify followed creator (the notification becomes sent)",
            "operationId": null,
            "statusAfter": "sent",
            "automatic": true,
            "kind": "note",
            "record": "notification"
          }
        ]
      },
      {
        "id": "moderate_content",
        "name": "Report and moderate content",
        "outcome": "Violating content is hidden from the community",
        "roles": [
          "Member",
          "Moderator"
        ],
        "steps": [
          {
            "id": "moderate_content_1",
            "role": "Member",
            "actor": "Member",
            "title": "Report clip or comment (the report becomes pending). Rule: Reported item must exist",
            "operationId": "report.create",
            "statusAfter": "pending",
            "page": "reports-new",
            "route": "/reports/new",
            "target": {
              "section": "report-create-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "report"
          },
          {
            "id": "moderate_content_2",
            "role": "Moderator",
            "actor": "Moderator",
            "title": "Review report (the report becomes reviewed)",
            "operationId": "report.review",
            "statusAfter": "reviewed",
            "page": "moderator-area-reports-id",
            "route": "/moderator-area/reports/[id]",
            "target": {
              "section": "reports-detail",
              "action": "review"
            },
            "kind": "do",
            "record": "report",
            "needs": {
              "step": "moderate_content_1",
              "role": "Member",
              "status": "pending"
            }
          },
          {
            "id": "moderate_content_3",
            "role": "Moderator",
            "actor": "Moderator",
            "title": "Hide violating content (the clip becomes hidden). Rule: Only content breaking rules may be hidden",
            "operationId": "clip.hide",
            "statusAfter": "hidden",
            "page": "moderator-area-clips-id",
            "route": "/moderator-area/clips/[id]",
            "target": {
              "section": "clips-detail",
              "action": "hide"
            },
            "kind": "do",
            "record": "clip"
          }
        ]
      }
    ]
  }
}
