  "workflows": {
    "version": "376501bacefa",
    "tours": [
      {
        "id": "watch_and_engage_video",
        "name": "Watch and Engage with Videos",
        "outcome": "Viewer watches a video and interacts via like or comment",
        "roles": [
          "Viewer"
        ],
        "steps": [
          {
            "id": "step_browse_feed",
            "role": "Viewer",
            "actor": "Viewer",
            "title": "Browse short video feed (the video becomes viewed). Rule: Only published videos are displayed",
            "operationId": "video.view",
            "statusAfter": "viewed",
            "page": "viewers-videos",
            "route": "/viewers/videos",
            "target": {
              "section": "videos-list",
              "action": "view"
            },
            "kind": "do",
            "record": "video"
          },
          {
            "id": "step_like_video",
            "role": "Viewer",
            "actor": "Viewer",
            "title": "Like video (the like becomes liked). Rule: A viewer can like a video only once",
            "operationId": "like.create",
            "statusAfter": "liked",
            "page": "viewers-videos-id-likes-new",
            "route": "/viewers/videos/[id]/likes/new",
            "target": {
              "section": "like-create-in-video-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "like"
          }
        ]
      },
      {
        "id": "publish_video",
        "name": "Publish Short Video",
        "outcome": "Short video is published and visible on the feed",
        "roles": [
          "Creator"
        ],
        "steps": [
          {
            "id": "step_upload_video",
            "role": "Creator",
            "actor": "Creator",
            "title": "Upload video file with title (the video becomes published). Rule: File must be a supported video format under maximum allowed duration",
            "operationId": "video.create",
            "statusAfter": "published",
            "page": "videos-new",
            "route": "/videos/new",
            "target": {
              "section": "video-create-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "video"
          }
        ]
      }
    ]
