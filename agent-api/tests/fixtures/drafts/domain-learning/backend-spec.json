  "project": {
    "description": "An online course platform where instructors publish self-paced courses and learners enroll, progress through ordered lessons and quizzes, and review finished courses.",
    "name": "Brightpath Academy",
    "slug": "brightpath-academy"
  },
  "relationships": [
    {
      "foreignKey": "categoryId",
      "from": "Category",
      "name": "categoryCourses",
      "onDelete": "RESTRICT",
      "to": "Course",
      "type": "one-to-many"
    },
    {
      "foreignKey": "courseId",
