        },
        {
          "index": true,
          "name": "learnerId",
          "required": true,
          "type": "uuid"
        },
        {
          "default": "COMPLETED",
          "name": "status",
          "required": true,
          "type": "enum",
          "values": [
            "COMPLETED"
          ]
