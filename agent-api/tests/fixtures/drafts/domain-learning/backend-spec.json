    {
      "displayField": "name",
      "fields": [
        {
          "name": "id",
          "primary": true,
          "type": "uuid"
        },
        {
          "maxLength": 80,
          "name": "name",
          "required": true,
          "type": "string",
          "unique": true
        },
        {
          "name": "description",
          "required": false,
          "type": "text"
        }
      ],
      "name": "Category"
    },
    {
      "displayField": "title",
