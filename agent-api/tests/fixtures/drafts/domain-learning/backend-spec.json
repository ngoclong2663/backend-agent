        {
          "name": "id",
          "primary": true,
          "type": "uuid"
        },
        {
          "index": true,
          "name": "categoryId",
          "required": true,
          "type": "uuid"
        },
        {
          "index": true,
          "name": "instructorId",
          "required": true,
          "type": "uuid"
        },
        {
          "maxLength": 150,
          "name": "title",
          "required": true,
          "type": "string"
        },
        {
          "maxLength": 1000,
          "name": "summary",
          "required": false,
          "type": "text"
        },
        {
          "name": "coverImage",
          "nullable": true,
          "required": false,
          "type": "image"
        },
        {
          "default": "DRAFT",
          "name": "status",
          "required": true,
          "type": "enum",
          "values": [
            "DRAFT",
            "PUBLISHED"
          ]
        },
        {
          "default": "now",
          "name": "createdAt",
          "required": true,
          "type": "datetime"
        }
      ],
      "name": "Course"
    },
    {
