    {
      "auth": "jwt",
      "description": "Instructor publishes a draft course once it contains at least one lesson. Status transitions from DRAFT to PUBLISHED.",
      "entity": "Course",
      "method": "POST",
      "operationId": "course.publish",
      "path": "/courses/{id}/publish",
      "policy": "ownCourse",
      "rules": [
        "courseStatusFlow"
      ],
      "type": "custom",
      "response": {
        "entity": "Course"
      }
    },
    {
      "auth": "jwt",
      "description": "Administrator unpublishes a non-compliant or outdated course, moving it back to DRAFT or unpublished.",
      "entity": "Course",
      "method": "POST",
      "operationId": "course.unpublish",
      "path": "/courses/{id}/unpublish",
      "policy": "adminOnly",
      "type": "custom",
      "response": {
        "entity": "Course"
      }
