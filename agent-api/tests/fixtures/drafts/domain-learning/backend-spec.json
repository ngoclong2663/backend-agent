  "rules": [
    {
      "description": "A course moves from DRAFT to PUBLISHED when published.",
      "entity": "Course",
      "id": "courseStatusFlow",
      "kind": "transition",
      "params": {
        "field": "status",
        "transitions": {
          "DRAFT": [
            "PUBLISHED"
          ],
          "PUBLISHED": [
            "DRAFT"
          ]
        }
      }
    },
    {
      "description": "Enrollment transitions from ACTIVE to COMPLETED upon course completion.",
      "entity": "Enrollment",
      "id": "enrollmentStatusFlow",
      "kind": "transition",
      "params": {
        "field": "status",
        "transitions": {
          "ACTIVE": [
            "COMPLETED"
          ]
        }
      }
    },
    {
      "description": "A learner cannot be actively enrolled in the same course more than once.",
      "entity": "Enrollment",
      "id": "uniqueActiveEnrollment",
      "kind": "uniqueTogether",
      "params": {
        "fields": [
          "courseId",
          "learnerId"
        ],
        "where": {
          "status": "ACTIVE"
        }
      }
    },
    {
      "description": "A learner tracks completion per lesson per enrollment only once.",
      "entity": "LessonProgress",
      "id": "uniqueLessonProgress",
      "kind": "uniqueTogether",
      "params": {
        "fields": [
          "enrollmentId",
          "lessonId"
        ]
      }
    },
    {
      "description": "A learner can submit at most one review per course.",
      "entity": "Review",
      "id": "uniqueCourseReview",
      "kind": "uniqueTogether",
      "params": {
        "fields": [
          "courseId",
          "learnerId"
        ]
      }
    }
  ],
