  "workflows": {
    "version": "af9dfa4c8be5",
    "tours": [
      {
        "id": "learner_course_completion",
        "name": "Course Learning and Completion",
        "outcome": "Learner successfully completes all lessons in order and finishes the course.",
        "roles": [
          "learner"
        ],
        "steps": [
          {
            "id": "browse_catalogue",
            "role": "learner",
            "actor": "Learner",
            "title": "Browse catalogue by category and select course. Rule: Course must be published",
            "operationId": "course.list",
            "page": "courses",
            "route": "/courses",
            "target": {
              "section": "courses-list",
              "action": null
            },
            "kind": "look",
            "record": "course"
          },
          {
            "id": "enroll_course",
            "role": "learner",
            "actor": "Learner",
            "title": "Enroll in the selected course (the enrollment becomes active). Rule: Learner cannot already be actively enrolled",
            "operationId": "enrollment.create",
            "statusAfter": "active",
            "page": "courses-id",
            "route": "/courses/[id]",
            "target": {
              "section": "courses-detail",
              "action": "add-enrollments"
            },
            "kind": "do",
            "record": "enrollment"
          },
          {
            "id": "resume_lesson",
            "role": "learner",
            "actor": "Learner",
            "title": "Open current lesson where left off (the enrollment becomes active). Rule: Must follow lesson order",
            "operationId": "enrollment.get",
            "statusAfter": "active",
            "page": "enrollments-id",
            "route": "/enrollments/[id]",
            "target": {
              "section": "enrollments-detail",
              "action": null
            },
            "kind": "look",
            "record": "enrollment"
          },
          {
            "id": "take_quiz",
            "role": "learner",
            "actor": "Learner",
            "title": "Take quiz at the end of the lesson if present (the quiz_submission becomes passed). Rule: Quiz questions must all be answered",
            "operationId": "quizSubmission.create",
            "statusAfter": "passed",
            "page": "quizes-id",
            "route": "/quizes/[id]",
            "target": {
              "section": "quizes-detail",
              "action": "add-quiz-submissions"
            },
            "kind": "do",
            "record": "quiz_submission"
          },
          {
            "id": "complete_lesson",
            "role": "learner",
            "actor": "Learner",
            "title": "Mark lesson as complete (the lesson_progress becomes completed). Rule: Previous lessons and required quiz must be completed",
            "operationId": "lessonProgress.create",
            "statusAfter": "completed",
            "page": "enrollments-id",
            "route": "/enrollments/[id]",
            "target": {
              "section": "enrollments-detail",
              "action": "add-lesson-progresses"
            },
            "kind": "do",
            "record": "lesson_progress"
          },
          {
            "id": "complete_course",
            "role": "learner",
            "actor": "Learner",
            "title": "Complete the final lesson and complete course (the enrollment becomes completed). Rule: All lessons in the course must be completed",
            "operationId": "enrollment.complete",
            "statusAfter": "completed",
            "page": "enrollments-id",
            "route": "/enrollments/[id]",
            "target": {
              "section": "enrollments-detail",
              "action": "complete"
            },
            "kind": "do",
            "record": "enrollment",
            "needs": {
              "step": "enroll_course",
              "role": "learner",
              "status": "active"
            }
          }
        ]
      },
      {
        "id": "course_authoring",
        "name": "Course Authoring and Publishing",
        "outcome": "A structured course with ordered lessons is published to the catalogue.",
        "roles": [
          "instructor"
        ],
        "steps": [
          {
            "id": "create_draft",
            "role": "instructor",
            "actor": "Instructor",
            "title": "Create course draft under a category (the course becomes draft). Rule: Category must exist",
            "operationId": "course.create",
            "statusAfter": "draft",
            "page": "instructors-categories-id-courses-new",
            "route": "/instructors/categories/[id]/courses/new",
            "target": {
              "section": "course-create-in-category-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "course"
          },
          {
            "id": "add_lessons",
            "role": "instructor",
            "actor": "Instructor",
            "title": "Add ordered video or text lessons to course (the lesson becomes draft). Rule: Lessons must have a defined sequence order",
            "operationId": "lesson.create",
            "statusAfter": "draft",
            "page": "instructors-courses-id",
            "route": "/instructors/courses/[id]",
            "target": {
              "section": "courses-detail",
              "action": "add-lessons"
            },
            "kind": "do",
            "record": "lesson"
          },
          {
            "id": "add_quiz",
            "role": "instructor",
            "actor": "Instructor",
            "title": "Attach short quiz to lesson (the quiz becomes draft). Rule: Quiz must belong to a lesson",
            "operationId": "quiz.create",
            "statusAfter": "draft",
            "page": "instructors-lessons-id",
            "route": "/instructors/lessons/[id]",
            "target": {
              "section": "lessons-detail",
              "action": "add-quizes"
            },
            "kind": "do",
            "record": "quiz"
          },
          {
            "id": "publish_course",
            "role": "instructor",
            "actor": "Instructor",
            "title": "Publish the complete course (the course becomes published). Rule: Course must contain at least one lesson",
            "operationId": "course.publish",
            "statusAfter": "published",
            "page": "instructors-courses-id",
            "route": "/instructors/courses/[id]",
            "target": {
              "section": "courses-detail",
              "action": "publish"
            },
            "kind": "do",
            "record": "course",
            "needs": {
              "step": "create_draft",
              "role": "instructor",
              "status": "draft"
            }
          }
        ]
      },
      {
        "id": "course_review",
        "name": "Course Rating and Reviewing",
        "outcome": "A public rating and review are posted for a completed course.",
        "roles": [
          "learner"
        ],
        "steps": [
          {
            "id": "submit_review",
            "role": "learner",
            "actor": "Learner",
            "title": "Submit star rating and short review for finished course (the review becomes published). Rule: Learner must have completed the course",
            "operationId": "review.create",
            "statusAfter": "published",
            "page": "courses-id",
            "route": "/courses/[id]",
            "target": {
              "section": "courses-detail",
              "action": "add-reviews"
            },
            "kind": "do",
            "record": "review"
          }
        ]
      }
    ]
  }
}
