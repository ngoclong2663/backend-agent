          "type": "boolean",
          "label": "Online Status",
          "required": false,
          "help": "Toggle online to receive delivery offers"
        }
      ],
      "submitLabel": "Save changes",
      "onSuccess": {
        "toast": "Driver Profile saved",
        "navigate": "drivers-driver-profiles-id"
      }
    }
