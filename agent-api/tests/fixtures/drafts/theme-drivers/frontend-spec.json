    "workflows": {
      "version": "f028db6af648",
      "tours": [
        {
          "id": "fulfill_delivery",
          "name": "Fulfill Delivery",
          "outcome": "Parcel delivered with photographic proof of drop-off",
          "roles": [
            "Driver",
            "Shop"
          ],
          "steps": [
            {
              "id": "step_create_delivery",
              "role": "Shop",
              "actor": "Shop",
              "title": "Request parcel delivery (the delivery becomes offered). Rule: Requires pickup address, drop-off address, customer name, phone, and parcel size",
              "operationId": "delivery.create",
              "statusAfter": "offered",
              "page": "deliveries-new",
              "route": "/deliveries/new",
              "target": {
                "section": "delivery-create-form",
                "action": "submit"
              },
              "kind": "do",
              "record": "delivery"
            },
            {
              "id": "step_accept_offer",
              "role": "Driver",
              "actor": "Driver",
              "title": "Accept delivery offer (the delivery becomes accepted). Rule: Driver must be online, carry one delivery at a time, and offer not already taken",
              "operationId": "delivery.accept",
              "statusAfter": "accepted",
              "page": "drivers-deliveries-id",
              "route": "/drivers/deliveries/[id]",
              "target": {
                "section": "deliveries-detail",
                "action": "accept"
              },
              "kind": "do",
              "record": "delivery",
              "needs": {
                "step": "step_create_delivery",
                "role": "Shop",
                "status": "offered"
              }
            },
            {
              "id": "step_going_pickup",
              "role": "Driver",
              "actor": "Driver",
              "title": "Confirm going to pickup (the delivery becomes going_to_pickup)",
              "operationId": "delivery.confirmGoingToPickup",
              "statusAfter": "going_to_pickup",
              "page": "drivers-deliveries-id",
              "route": "/drivers/deliveries/[id]",
              "target": {
                "section": "deliveries-detail",
                "action": "confirm-going-to-pickup"
              },
              "kind": "do",
              "record": "delivery",
              "needs": {
                "step": "step_accept_offer",
                "role": "Driver",
                "status": "accepted"
              }
            },
            {
              "id": "step_picked_up",
              "role": "Driver",
              "actor": "Driver",
              "title": "Confirm parcel picked up (the delivery becomes picked_up)",
              "operationId": "delivery.confirmPickedUp",
              "statusAfter": "picked_up",
              "page": "drivers-deliveries-id",
              "route": "/drivers/deliveries/[id]",
              "target": {
                "section": "deliveries-detail",
                "action": "confirm-picked-up"
              },
              "kind": "do",
              "record": "delivery",
              "needs": {
                "step": "step_going_pickup",
                "role": "Driver",
                "status": "going_to_pickup"
              }
            },
            {
              "id": "step_going_dropoff",
              "role": "Driver",
              "actor": "Driver",
              "title": "Confirm going to drop-off (the delivery becomes going_to_dropoff)",
              "operationId": "delivery.confirmGoingToDropoff",
              "statusAfter": "going_to_dropoff",
              "page": "drivers-deliveries-id",
              "route": "/drivers/deliveries/[id]",
              "target": {
                "section": "deliveries-detail",
                "action": "confirm-going-to-dropoff"
              },
              "kind": "do",
              "record": "delivery",
              "needs": {
                "step": "step_picked_up",
                "role": "Driver",
                "status": "picked_up"
              }
            },
            {
              "id": "step_complete_delivery",
              "role": "Driver",
              "actor": "Driver",
              "title": "Complete delivery with door photo (the delivery becomes delivered). Rule: Must include photo of parcel at the door",
              "operationId": "delivery.completeDelivery",
              "statusAfter": "delivered",
              "page": "drivers-deliveries-id",
              "route": "/drivers/deliveries/[id]",
              "target": {
                "section": "deliveries-detail",
                "action": "complete-delivery"
              },
              "kind": "do",
              "record": "delivery",
              "needs": {
                "step": "step_going_dropoff",
                "role": "Driver",
                "status": "going_to_dropoff"
              }
            }
          ]
        },
        {
          "id": "track_delivery",
          "name": "Track Delivery Progress",
          "outcome": "Customer knows the current status of their parcel",
          "roles": [],
          "steps": [
            {
              "id": "step_view_progress",
              "role": null,
              "actor": "Customer",
              "title": "View delivery progress",
              "operationId": "delivery.get",
              "page": "deliveries-id",
              "route": "/deliveries/[id]",
              "target": {
                "section": "deliveries-detail",
                "action": null
              },
              "skip": "no app role plays this actor",
              "kind": "note",
              "record": "delivery"
            }
          ]
        },
        {
          "id": "monitor_operations",
          "name": "Monitor Operations",
          "outcome": "Dispatcher maintains awareness of all deliveries and online drivers",
          "roles": [
            "Dispatcher"
          ],
          "steps": [
            {
              "id": "step_view_operations",
              "role": "Dispatcher",
              "actor": "Dispatcher",
              "title": "View deliveries by status and online drivers",
              "operationId": "delivery.list",
              "page": "home",
              "route": "/",
              "target": {
                "section": "recent-deliveries",
                "action": null
              },
              "kind": "look",
              "record": "delivery"
            }
          ]
        }
      ]
    }
  },
