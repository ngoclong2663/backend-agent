  "forms": [
    {
      "id": "delivery_create",
      "operationId": "delivery.create",
      "fields": [
        {
          "name": "pickupAddress",
          "type": "string",
          "label": "Pickup Address",
          "required": true,
          "maxLength": 255
        },
        {
          "name": "dropoffAddress",
          "type": "string",
          "label": "Drop-off Address",
          "required": true,
          "maxLength": 255
        },
        {
          "name": "customerName",
          "type": "string",
          "label": "Customer Name",
          "required": true,
          "maxLength": 120
        },
        {
          "name": "customerPhone",
          "type": "tel",
          "label": "Customer Phone",
          "required": true,
          "maxLength": 30
        },
        {
          "name": "parcelSize",
          "type": "enum",
          "label": "Parcel Size",
          "required": true,
          "values": [
            "SMALL",
            "MEDIUM",
            "LARGE"
          ],
          "help": "Size category of parcel (small, medium, large)"
        },
        {
          "name": "fee",
          "type": "decimal",
          "label": "Delivery Fee",
          "required": true,
          "min": 0
        }
      ],
      "submitLabel": "Create delivery",
      "onSuccess": {
        "toast": "Delivery created",
        "navigate": "deliveries-id"
      }
    },
    {
      "id": "delivery_completeDelivery",
      "operationId": "delivery.completeDelivery",
      "params": {
        "id": "$route.id"
      },
      "fields": [
        {
          "name": "dropoffPhoto",
          "type": "string",
          "label": "Drop-off Photo",
          "required": false,
          "upload": {
            "entity": "Delivery",
            "field": "dropoffPhoto",
            "presign": "files.presign",
            "kind": "image",
            "accept": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif"
            ],
            "maxSize": 5242880
          },
          "help": "Photo of parcel at door required upon delivery"
        }
      ],
      "submitLabel": "Complete delivery",
      "onSuccess": {
        "toast": "Complete delivery: done"
      }
    },
    {
      "id": "auth_login",
      "operationId": "auth.login",
      "fields": [
        {
          "name": "email",
          "type": "email",
          "label": "E-mail",
          "required": true,
          "maxLength": 255
        },
        {
          "name": "password",
          "type": "password",
          "label": "Password",
          "required": true
        }
      ],
      "submitLabel": "Sign in"
    },
    {
      "id": "auth_register",
      "operationId": "auth.register",
      "fields": [
        {
          "name": "email",
          "type": "email",
          "label": "E-mail",
          "required": true,
          "maxLength": 255
        },
        {
          "name": "password",
          "type": "password",
          "label": "Password",
          "required": true,
          "maxLength": 128
        }
      ],
      "submitLabel": "Create account"
    },
    {
      "id": "drivers_delivery_completeDelivery",
      "operationId": "delivery.completeDelivery",
      "params": {
        "id": "$route.id"
      },
      "fields": [
        {
          "name": "dropoffPhoto",
          "type": "string",
          "label": "Drop-off Photo",
          "required": false,
          "upload": {
            "entity": "Delivery",
            "field": "dropoffPhoto",
            "presign": "files.presign",
            "kind": "image",
            "accept": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif"
            ],
            "maxSize": 5242880
          },
          "help": "Photo of parcel at door required upon delivery"
        }
      ],
      "submitLabel": "Complete delivery",
      "onSuccess": {
        "toast": "Complete delivery: done"
      }
    },
    {
      "id": "drivers_driverProfile_update",
