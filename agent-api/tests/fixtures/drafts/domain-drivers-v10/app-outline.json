  "workflows": {
    "version": "efe22a34b6fb",
    "tours": [
      {
        "id": "deliver_parcel",
        "name": "Parcel Delivery Fulfillment",
        "outcome": "Parcel is picked up from the shop, delivered to the customer door with photo proof, and earnings are credited.",
        "roles": [
          "customer",
          "driver",
          "shop_owner"
        ],
        "steps": [
          {
            "id": "create_delivery",
            "role": "shop_owner",
            "actor": "Shop Owner",
            "title": "Books a delivery with pickup, drop-off, customer contact, and parcel size (the delivery becomes pending). Rule: Must provide valid pickup address, drop-off address, customer name, phone, and parcel size",
            "operationId": "delivery.create",
            "statusAfter": "pending",
            "page": "deliveries-new",
            "route": "/deliveries/new",
            "target": {
              "section": "delivery-create-form",
              "action": "submit"
            },
            "kind": "do",
            "record": "delivery"
          },
          {
            "id": "go_online",
            "role": "driver",
            "actor": "Driver",
            "title": "Switches status to online to receive offers (the driver_shift becomes online). Rule: Driver must be authenticated",
            "operationId": "driverShift.setOnline",
            "statusAfter": "online",
            "page": "drivers-driver-shifts",
            "route": "/drivers/driver-shifts",
            "target": {
              "section": "driver-shifts-actions",
              "action": "set-online"
            },
            "kind": "do",
            "record": "driver_shift"
          },
          {
            "id": "accept_offer",
            "role": "driver",
            "actor": "Driver",
            "title": "Accepts an available delivery offer (the delivery becomes assigned). Rule: Only one driver can take each offer and a driver carries one delivery at a time",
            "operationId": "delivery.accept",
            "statusAfter": "assigned",
            "page": "drivers-deliveries-id",
            "route": "/drivers/deliveries/[id]",
            "target": {
              "section": "deliveries-detail",
              "action": "accept"
            },
            "kind": "do",
            "record": "delivery",
            "needs": {
              "step": "create_delivery",
              "role": "shop_owner",
              "status": "pending"
            }
          },
          {
            "id": "going_to_pickup",
            "role": "driver",
            "actor": "Driver",
            "title": "Confirms heading toward pickup location (the delivery becomes going_to_pickup). Rule: Must be the assigned driver",
            "operationId": "delivery.goingToPickup",
            "statusAfter": "going_to_pickup",
            "page": "drivers-deliveries-id",
            "route": "/drivers/deliveries/[id]",
            "target": {
              "section": "deliveries-detail",
              "action": "going-to-pickup"
            },
            "kind": "do",
            "record": "delivery",
            "needs": {
              "step": "accept_offer",
              "role": "driver",
              "status": "assigned"
            }
          },
          {
            "id": "confirm_pickup",
            "role": "driver",
            "actor": "Driver",
            "title": "Confirms parcel collected from shop (the delivery becomes picked_up). Rule: Must be at pickup location",
            "operationId": "delivery.pickedUp",
            "statusAfter": "picked_up",
            "page": "drivers-deliveries-id",
            "route": "/drivers/deliveries/[id]",
            "target": {
              "section": "deliveries-detail",
              "action": "picked-up"
            },
            "kind": "do",
            "record": "delivery",
            "needs": {
              "step": "going_to_pickup",
              "role": "driver",
              "status": "going_to_pickup"
            }
          },
          {
            "id": "going_to_dropoff",
            "role": "driver",
            "actor": "Driver",
            "title": "Confirms heading toward drop-off location (the delivery becomes going_to_dropoff). Rule: Must have picked up the parcel",
            "operationId": "delivery.goingToDropoff",
            "statusAfter": "going_to_dropoff",
            "page": "drivers-deliveries-id",
            "route": "/drivers/deliveries/[id]",
            "target": {
              "section": "deliveries-detail",
              "action": "going-to-dropoff"
            },
            "kind": "do",
            "record": "delivery",
            "needs": {
              "step": "confirm_pickup",
              "role": "driver",
              "status": "picked_up"
            }
          },
          {
            "id": "complete_delivery",
            "role": "driver",
            "actor": "Driver",
            "title": "Submits photo of parcel at door and confirms completion (the delivery becomes delivered). Rule: A photo of the parcel at the door is required",
            "operationId": "delivery.deliver",
            "statusAfter": "delivered",
            "page": "drivers-deliveries-id",
            "route": "/drivers/deliveries/[id]",
            "target": {
              "section": "deliveries-detail",
              "action": "deliver"
            },
            "kind": "do",
            "record": "delivery",
            "needs": {
              "step": "going_to_dropoff",
              "role": "driver",
              "status": "going_to_dropoff"
            }
          },
          {
            "id": "track_progress",
            "role": "customer",
            "actor": "Customer",
            "title": "Views delivery tracking page with live status updates. Rule: Must have a valid delivery tracking identifier",
            "operationId": "delivery.get",
            "page": "customers-deliveries-id",
            "route": "/customers/deliveries/[id]",
            "target": {
              "section": "deliveries-detail",
              "action": null
            },
            "kind": "look",
            "record": "delivery"
          }
        ]
      },
      {
        "id": "track_earnings",
        "name": "Driver Earnings Review",
        "outcome": "Driver reviews their accumulated delivery earnings for today and the current week.",
        "roles": [
          "driver"
        ],
        "steps": [
          {
            "id": "view_earnings",
            "role": "driver",
            "actor": "Driver",
            "title": "Views total delivery earnings for today and this week. Rule: Aggregates fees only from successfully delivered parcels",
            "operationId": "delivery.driverEarningsToday",
            "page": "drivers-dashboard",
            "route": "/drivers/dashboard",
            "target": {
              "section": "figure-6",
              "action": null
            },
            "kind": "look",
            "record": "earnings_summary"
          }
        ]
      },
      {
        "id": "monitor_operations",
        "name": "Dispatch Operations Monitoring",
        "outcome": "Dispatcher verifies delivery statuses and fleet availability to keep local fulfillment running smoothly.",
        "roles": [
          "dispatcher"
        ],
        "steps": [
          {
            "id": "review_dispatch_board",
            "role": "dispatcher",
            "actor": "Dispatcher",
            "title": "Reviews all deliveries filtered by status and monitors which drivers are online. Rule: Displays real-time status of all active deliveries and online drivers",
            "operationId": "delivery.countByStatus",
            "page": "home",
            "route": "/",
            "target": {
              "section": "figure-4",
              "action": null
            },
            "kind": "look",
            "record": "dispatch_overview"
          }
        ]
      }
    ]
  }
}
