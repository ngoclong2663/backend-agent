{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backend-generation-agent.local/schemas/backend-spec-1.0.json",
  "$defs": {
    "Aggregate": {
      "additionalProperties": false,
      "description": "Epic 21: a figure computed from an entity's records, written from templates like CRUD (no engine): `fn` of\n`field` (count needs none), optionally grouped by a field, limited to the current period of a date field, and\nfiltered by equality. The response is `{\"value\": n}` or, grouped, `[{\"key\": \"…\", \"value\": n}, …]`.",
      "properties": {
        "fn": {
          "enum": [
            "count",
            "sum",
            "avg",
            "min",
            "max"
          ],
          "title": "Fn",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "groupBy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Groupby"
        },
        "period": {
          "anyOf": [
            {
              "enum": [
                "day",
                "week",
                "month",
                "year"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "dateField": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Datefield"
        },
        "filters": {
          "additionalProperties": true,
          "default": {},
          "title": "Filters",
          "type": "object"
        }
      },
      "required": [
        "fn"
      ],
      "title": "Aggregate",
      "type": "object"
    },
    "Auth": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "jwt",
          "title": "Type",
          "type": "string"
        },
        "userEntity": {
          "default": "User",
          "title": "Userentity",
          "type": "string"
        },
        "loginField": {
          "default": "email",
          "title": "Loginfield",
          "type": "string"
        },
        "roles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "emailVerification": {
          "default": false,
          "title": "Emailverification",
          "type": "boolean"
        },
        "passwordReset": {
          "default": false,
          "title": "Passwordreset",
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "title": "Auth",
      "type": "object"
    },
    "BackgroundJob": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "trigger": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/JobTrigger"
            }
          ],
          "title": "Trigger"
        },
        "action": {
          "default": "custom",
          "enum": [
            "log",
            "custom"
          ],
          "title": "Action",
          "type": "string"
        },
        "maxAttempts": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "Maxattempts",
          "type": "integer"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name",
        "trigger"
      ],
      "title": "BackgroundJob",
      "type": "object"
    },
    "Email": {
      "additionalProperties": false,
      "description": "Story 10.7: an email sent through a job when its trigger fires. `to`: a literal address, `currentUser`, or a\npath from the trigger's record (`task.project.ownerEmail`); `subject` and `body` take `{{path}}` placeholders.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "trigger": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/JobTrigger"
            }
          ],
          "title": "Trigger"
        },
        "to": {
          "maxLength": 255,
          "minLength": 1,
          "title": "To",
          "type": "string"
        },
        "subject": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "body": {
          "minLength": 1,
          "title": "Body",
          "type": "string"
        }
      },
      "required": [
        "name",
        "trigger",
        "to",
        "subject",
        "body"
      ],
      "title": "Email",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 63,
          "pattern": "^[A-Z][A-Za-z0-9]*$",
          "title": "Name",
          "type": "string"
        },
        "table": {
          "anyOf": [
            {
              "maxLength": 63,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldDef"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "indexes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/IndexDef"
          },
          "title": "Indexes",
          "type": "array"
        },
        "uniqueConstraints": {
          "default": [],
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Uniqueconstraints",
          "type": "array"
        },
        "displayField": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayfield"
        }
      },
      "required": [
        "name",
        "fields"
      ],
      "title": "Entity",
      "type": "object"
    },
    "FeatureAttachment": {
      "additionalProperties": false,
      "description": "Epic 33: a feature plugin attached to an entity (`reactions` on `Clip`). Its entities, operations and rules are\nmerged into this spec as plain entries; what plain entries can't say (computed fields) is here.",
      "properties": {
        "feature": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Feature",
          "type": "string"
        },
        "on": {
          "title": "On",
          "type": "string"
        },
        "options": {
          "additionalProperties": true,
          "default": {},
          "title": "Options",
          "type": "object"
        },
        "entities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Entities",
          "type": "array"
        },
        "computed": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FeatureComputedField"
          },
          "title": "Computed",
          "type": "array"
        }
      },
      "required": [
        "feature",
        "on"
      ],
      "title": "FeatureAttachment",
      "type": "object"
    },
    "FeatureComputedField": {
      "additionalProperties": false,
      "description": "Epic 33: a read-only field a feature adds to its target's responses (`likeCount`, `myLikeId`). `count`: rows of\n`entity` whose `key` is the record; `mine`: the id of the caller's row (its `owner` is the caller), else null.",
      "properties": {
        "field": {
          "pattern": "^[a-z][a-zA-Z0-9]*$",
          "title": "Field",
          "type": "string"
        },
        "kind": {
          "enum": [
            "count",
            "mine"
          ],
          "title": "Kind",
          "type": "string"
        },
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "where": {
          "additionalProperties": true,
          "default": {},
          "title": "Where",
          "type": "object"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "match": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "field",
        "kind",
        "entity",
        "key"
      ],
      "title": "FeatureComputedField",
      "type": "object"
    },
    "FieldDef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 63,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "uuid",
            "string",
            "text",
            "integer",
            "float",
            "decimal",
            "boolean",
            "date",
            "datetime",
            "enum",
            "json",
            "file",
            "image",
            "video",
            "audio",
            "subtitles"
          ],
          "title": "Type",
          "type": "string"
        },
        "primary": {
          "default": false,
          "title": "Primary",
          "type": "boolean"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "nullable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nullable"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "index": {
          "default": false,
          "title": "Index",
          "type": "boolean"
        },
        "default": {
          "default": null,
          "title": "Default"
        },
        "values": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        },
        "maxLength": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxlength"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "accept": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accept"
        },
        "maxSize": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxsize"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "FieldDef",
      "type": "object"
    },
    "FrontendBinding": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "title": "Page",
          "type": "string"
        },
        "componentPath": {
          "title": "Componentpath",
          "type": "string"
        },
        "component": {
          "title": "Component",
          "type": "string"
        },
        "operationId": {
          "title": "Operationid",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "default": {},
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "page",
        "componentPath",
        "component",
        "operationId"
      ],
      "title": "FrontendBinding",
      "type": "object"
    },
    "IndexDef": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "name": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "fields"
      ],
      "title": "IndexDef",
      "type": "object"
    },
    "Integration": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "config": {
          "additionalProperties": true,
          "default": {},
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "Integration",
      "type": "object"
    },
    "JobTrigger": {
      "additionalProperties": false,
      "description": "Story 10.6: exactly one of an event (`task.created`, `<entity>.<custom>`), an operation id, a cron expression.",
      "properties": {
        "event": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event"
        },
        "operation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation"
        },
        "cron": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cron"
        }
      },
      "title": "JobTrigger",
      "type": "object"
    },
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "maxLength": 128,
          "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z0-9]+)+$",
          "title": "Operationid",
          "type": "string"
        },
        "type": {
          "enum": [
            "crud",
            "custom",
            "aggregate"
          ],
          "title": "Type",
          "type": "string"
        },
        "action": {
          "anyOf": [
            {
              "enum": [
                "create",
                "get",
                "list",
                "update",
                "delete"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "aggregate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Aggregate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "maxLength": 255,
          "pattern": "^/[A-Za-z0-9_\\-/{}.]*$",
          "title": "Path",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "auth": {
          "anyOf": [
            {
              "enum": [
                "none",
                "jwt"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auth"
        },
        "policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/PayloadSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/PayloadSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pagination": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/Pagination"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pagination"
        },
        "filters": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Filters",
          "type": "array"
        },
        "sort": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Sort",
          "type": "array"
        },
        "search": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Search",
          "type": "array"
        },
        "ranges": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Ranges",
          "type": "array"
        },
        "rules": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "operationId",
        "type",
        "method",
        "path"
      ],
      "title": "Operation",
      "type": "object"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "defaultLimit": {
          "default": 20,
          "maximum": 1000,
          "minimum": 1,
          "title": "Defaultlimit",
          "type": "integer"
        },
        "maxLimit": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Maxlimit",
          "type": "integer"
        }
      },
      "title": "Pagination",
      "type": "object"
    },
    "PayloadSchema": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        },
        "properties": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FieldDef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Properties"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "object",
                "array"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        }
      },
      "title": "PayloadSchema",
      "type": "object"
    },
    "Payments": {
      "additionalProperties": false,
      "description": "Story 10.9: one entity is paid for. The amount is the record's (`amountField`, or the field of a `sumEquals`\nrule on it), never the client's; `statusField` moves to `paidStatus` (or `failedStatus`) when the provider says.",
      "properties": {
        "provider": {
          "const": "fake",
          "default": "fake",
          "title": "Provider",
          "type": "string"
        },
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "amountField": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amountfield"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "currencyField": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currencyfield"
        },
        "statusField": {
          "title": "Statusfield",
          "type": "string"
        },
        "paidStatus": {
          "title": "Paidstatus",
          "type": "string"
        },
        "failedStatus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
