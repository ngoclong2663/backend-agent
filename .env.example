# Copy with `make env` (fills HOST_WORKSPACE_ROOT and a random JWT_SECRET), then edit.

# Host ports (defaults avoid the usual 3000/5432/6379)
BGA_API_PORT=8100
BGA_UI_PORT=3100
BGA_PG_PORT=5442
BGA_REDIS_PORT=6389

POSTGRES_USER=bga
POSTGRES_PASSWORD=bga
POSTGRES_DB=agent

# At least 32 random characters. The API refuses to start with the example value.
JWT_SECRET=change-me-to-a-long-random-string
# email:password[:role], comma separated. Roles: USER (default), ADMIN. Local-development accounts only.
SEED_USERS=admin@bga.local:admin12345:ADMIN,user@bga.local:user12345

# Absolute host path for job workspaces; mounted at the same path inside the worker.
HOST_WORKSPACE_ROOT=/absolute/path/to/backend-generation-agent/.data/workspaces

LOG_LEVEL=INFO
WORKER_CONCURRENCY=2

# Code engines (Epic 3): claude_code | antigravity | fake
DEFAULT_ENGINE=claude_code
# fake = scripted test/demo engine; it only produces a valid backend for examples/specs/two-entity.json
# (docs/development/test-doubles.md). Set false for shared deployments.
ENABLE_FAKE_ENGINE=true
# Seconds each fake-engine step takes (raise it to watch the workflow in the UI)
FAKE_ENGINE_DELAY_SECONDS=0.3
ENGINE_TIMEOUT_SECONDS=900
ENGINE_MAX_TURNS=40
ENGINE_CONCURRENCY=3
# Claude Code: an API key, or a subscription login file (e.g. ~/.claude/.credentials.json, mounted read-only).
# macOS keeps the login in the Keychain; export it with
#   security find-generic-password -s "Claude Code-credentials" -w > ~/.claude/.credentials.json && chmod 600 ~/.claude/.credentials.json
ANTHROPIC_API_KEY=
CLAUDE_CREDENTIALS_HOST_FILE=
# Empty = claude-sonnet-5-5
CLAUDE_CODE_MODEL=
# Model overrides per purpose, as a JSON object, e.g. {"generate_assets": "claude-haiku-4-5"}
CLAUDE_CODE_PURPOSE_MODELS=
# Antigravity: gemini_api_key (needs GEMINI_API_KEY), adc (Google Cloud application default credentials), or
# account (the `agy` Google-account login on this machine; host dev worker only, not inside Docker)
ANTIGRAVITY_AUTH=gemini_api_key
GEMINI_API_KEY=
# Empty = gemini-3.8-flash-medium (`agy models` lists the choices)
ANTIGRAVITY_MODEL=
# Model overrides per purpose, as a JSON object; default {"generate_assets": "gemini-3.8-flash-low"}
ANTIGRAVITY_PURPOSE_MODELS=
# agy emits one agent response per tool call, so it needs a higher turn cap and more time than Claude Code
ANTIGRAVITY_MAX_TURNS=150
ANTIGRAVITY_TIMEOUT_SECONDS=2400
# Whole-job limit for antigravity runs (others use JOB_TIMEOUT_SECONDS, default 1800)
ANTIGRAVITY_JOB_TIMEOUT_SECONDS=10800

# Tracing (Epic 8, optional). Each generation becomes one LangSmith trace; the UI's trace view works without it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=fullstack-generation-agent
# Set to send traces to a LangSmith agent's environment instead of the project (beta, enabled per workspace;
# a workspace without it rejects the runs). Lowercase letters, digits and hyphens, e.g. fullstack-agent.
LANGSMITH_AGENT_ID=
# local | development | staging | production
LANGSMITH_AGENT_ENVIRONMENT=local
# Model calls and sandbox records are kept this many days after a generation ends (0 = forever)
TRACE_RETENTION_DAYS=30
# Price overrides, USD per 1M tokens (defaults: agent-api/src/engines/pricing.py). Unpriced models have no cost.
# MODEL_PRICES={"gemini-4-argon": {"input": 1.25, "output": 10, "cache_read": 0.125}}

# Preview containers (Epic 7): every COMPLETED backend runs as its own container on 127.0.0.1
PREVIEW_ENABLED=true
PREVIEW_PORT_RANGE=18000-18099
PREVIEW_MAX_RUNNING=3
PREVIEW_TTL_HOURS=2
INTEGRATION_WAIT_SECONDS=180
FRONTEND_COMPONENT_TEST_TIMEOUT_SECONDS=60
