# Copy with `make env` (fills HOST_WORKSPACE_ROOT and a random JWT_SECRET), then edit.

# Host ports (defaults avoid the usual 3000/5432/6379)
BGA_API_PORT=8100
BGA_UI_PORT=3100
BGA_PG_PORT=5442
BGA_REDIS_PORT=6389

POSTGRES_USER=bga
POSTGRES_PASSWORD=bga
POSTGRES_DB=agent

# At least 32 random characters. The API refuses to start with the example value.
JWT_SECRET=change-me-to-a-long-random-string
# email:password[:role], comma separated. Roles: USER (default), ADMIN. Local-development accounts only.
SEED_USERS=admin@bga.local:admin12345:ADMIN,user@bga.local:user12345

# Absolute host path for job workspaces; mounted at the same path inside the worker.
HOST_WORKSPACE_ROOT=/absolute/path/to/backend-generation-agent/.data/workspaces

LOG_LEVEL=INFO
WORKER_CONCURRENCY=2

# Code engines (Epic 3): claude_code | antigravity | fake
# The one engine switch: claude_code or antigravity. Generation, drafts and every LLM-only step follow it
# (DRAFT_ENGINE / LLM_PROVIDER, when set, override it).
DEFAULT_ENGINE=claude_code
# fake = scripted test/demo engine; it only produces a valid backend for examples/specs/two-entity.json
# (docs/development/test-doubles.md). Set false for shared deployments.
ENABLE_FAKE_ENGINE=true
# Seconds each fake-engine step takes (raise it to watch the workflow in the UI)
FAKE_ENGINE_DELAY_SECONDS=0.3
ENGINE_TIMEOUT_SECONDS=900
ENGINE_MAX_TURNS=40
ENGINE_CONCURRENCY=3
# An engine run that died on the network or the provider's API runs again in the same workdir (0 = never)
ENGINE_NETWORK_RETRIES=1
# Story 23.11: engine-written view slots for dynamic apps (off | engine); an opt-in experiment, off by default
APP_VIEW_SLOTS=off
# Claude Code: an API key, or a subscription login file (e.g. ~/.claude/.credentials.json, mounted read-only).
# macOS keeps the login in the Keychain; export it with
#   security find-generic-password -s "Claude Code-credentials" -w > ~/.claude/.credentials.json && chmod 600 ~/.claude/.credentials.json
ANTHROPIC_API_KEY=
# The Claude subscription for headless runs: run `claude setup-token` once and paste the token here (on macOS the
# desktop login lives in the keychain, which containers cannot read)
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CREDENTIALS_HOST_FILE=
# Empty = claude-sonnet-5-5
CLAUDE_CODE_MODEL=
# Model overrides per purpose, as a JSON object, e.g. {"generate_assets": "claude-haiku-4-5"}
CLAUDE_CODE_PURPOSE_MODELS=
# Antigravity: gemini_api_key (needs GEMINI_API_KEY), adc (Google Cloud application default credentials), or
# account (the `agy` Google-account login on this machine; host dev worker only, not inside Docker)
ANTIGRAVITY_AUTH=gemini_api_key
GEMINI_API_KEY=
# Empty = gemini-3.8-flash-medium (`agy models` lists the choices)
ANTIGRAVITY_MODEL=
# Epic 24: the provider of every LLM-only step (spec drafting and repairs, Epic 26's business workflow steps), each
# one turn with structured output: antigravity (agy, one-turn JSON; with ANTIGRAVITY_AUTH=account no per-token cost),
# claude_code (claude, one-turn JSON on the subscription login), gemini_api (billed per token). Empty = drafting
# follows DRAFT_ENGINE. The user's default (2026-11-07): antigravity.
LLM_PROVIDER=antigravity
# Epic 26: the business layer of dynamic apps (workflows and frozen expectations before the draft, the binding, the
# guided tour, the evaluation after the generation). Static sites never have it; a request's `businessWorkflows`
# overrides it. The user's default (2026-11-07): on for dynamic mode.
BUSINESS_WORKFLOWS=true
# Epic 34: one LLM turn designs a dynamic app's colours and type for its product (code checks it; the design data's
# theme is the fallback). A request's `designThemes` overrides it.
DESIGN_THEMES=true
# How drafts think (2026-11-08): thorough (each provider's model) or fast (FAST_DRAFT_MODELS, JSON per provider;
# empty = {"antigravity": "gemini-3.8-flash-low"}). A fast draft took 85 s instead of 15.6 min, with fewer of the
# requirement's rules; the UI picks it per draft.
DRAFT_SPEED=thorough
FAST_DRAFT_MODELS=
# --effort for the one-turn JSON steps (empty = the model's default); claude's cap per call on an API key only
ANTIGRAVITY_JSON_EFFORT=
CLAUDE_CODE_JSON_EFFORT=
CLAUDE_CODE_JSON_MAX_BUDGET_USD=
# The engine that drafts specs: antigravity_json, claude_code_json, gemini_api (Story 18.10). Empty = LLM_PROVIDER's
# (antigravity -> antigravity_json), else gemini_api when GEMINI_API_KEY is set. The Options page can pick another.
# Generation keeps the CLI engines. GEMINI_API_MODEL empty = gemini-3.8-flash; GEMINI_API_THINKING_BUDGET empty =
# the model's default.
DRAFT_ENGINE=
GEMINI_API_MODEL=
GEMINI_API_THINKING_BUDGET=
# Epic 21: after a frontend draft, design each page as an element tree (one engine call per page). false = the
# section pages only.
FRONTEND_TREES=true
# Story 22.7: where dynamic previews keep a signed-in user's token (local | cookie)
PREVIEW_AUTH_TOKEN_STORAGE=local
# Run a generated backend's own pytest suite in run_validation (false: the smoke calls against the contract only)
BACKEND_TESTS=false
# Model overrides per purpose, as a JSON object; default {"generate_assets": "gemini-3.8-flash-low"}
ANTIGRAVITY_PURPOSE_MODELS=
# agy emits one agent response per tool call, so it needs a higher turn cap and more time than Claude Code
ANTIGRAVITY_MAX_TURNS=150
ANTIGRAVITY_TIMEOUT_SECONDS=2400
# Whole-job limit for antigravity runs (others use JOB_TIMEOUT_SECONDS, default 1800)
ANTIGRAVITY_JOB_TIMEOUT_SECONDS=10800

# Photos. Provider: gemini (AI photos, Epic 19, paid per image) | unsplash (stock photos, Epic 27, free) | fake | none.
# gemini needs GEMINI_IMAGE_API_KEY (GEMINI_API_KEY is not used for them). unsplash needs UNSPLASH_ACCESS_KEY (an
# Unsplash application; demo applications get 50 requests an hour): photos are hotlinked and credited, never copied.
# FRONTEND_MAX_PHOTOS caps the paid (gemini) photos per draft / site; with unsplash it is not used (2026-11-09): the
# stock photos are bounded by the hour's requests and the search cache instead.
IMAGE_PROVIDER=gemini
UNSPLASH_ACCESS_KEY=
# The application name in the credits' referral links (utm_source)
UNSPLASH_APP_NAME=fullstack_generation_agent
GEMINI_IMAGE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_SIZE=1K
GEMINI_IMAGE_PRICE_USD=0.0336
IMAGE_CONCURRENCY=4
IMAGE_TIMEOUT_SECONDS=60
FRONTEND_MAX_PHOTOS=8

# Sample videos (Epic 31). VIDEO_PROVIDERS: the providers that are on, comma separated (youtube, pixabay; empty = none).
# youtube (Data API v3, YOUTUBE_API_KEY; 10,000 units a day, a search costs 100): videos people watch, embedded in
# YouTube's player through youtube-nocookie.com, loaded on play. pixabay (PIXABAY_API_KEY; 100 requests a minute,
# searches cached 24 h): MP4 files under the Pixabay Content License for hero background loops and seeded video
# fields, played by our own <video>; their posters are stored, the files are linked. Every video is credited.
# PIXABAY_STORE_VIDEOS=true would copy the files into the project too (off; measured in Story 31.5).
VIDEO_PROVIDERS=
YOUTUBE_API_KEY=
PIXABAY_API_KEY=
PIXABAY_STORE_VIDEOS=false

# Tracing (Epic 8, optional). Each generation becomes one LangSmith trace; the UI's trace view works without it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=fullstack-generation-agent
# Set to send traces to a LangSmith agent's environment instead of the project (beta, enabled per workspace;
# a workspace without it rejects the runs). Lowercase letters, digits and hyphens, e.g. fullstack-agent.
LANGSMITH_AGENT_ID=
# local | development | staging | production
LANGSMITH_AGENT_ENVIRONMENT=local
# Model calls and sandbox records are kept this many days after a generation ends (0 = forever)
TRACE_RETENTION_DAYS=30
# Price overrides, USD per 1M tokens (defaults: agent-api/src/engines/pricing.py). Unpriced models have no cost.
# MODEL_PRICES={"gemini-4-argon": {"input": 1.25, "output": 10, "cache_read": 0.125}}

# Preview containers (Epic 7): every COMPLETED backend runs as its own container on 127.0.0.1
PREVIEW_ENABLED=true
PREVIEW_PORT_RANGE=18000-18099
PREVIEW_MAX_RUNNING=3
PREVIEW_TTL_HOURS=2
INTEGRATION_WAIT_SECONDS=180
FRONTEND_COMPONENT_TEST_TIMEOUT_SECONDS=60
